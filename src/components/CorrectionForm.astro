---
/**
 * Netlify Forms-compatible correction/report form. Pure HTML: works with
 * zero JavaScript once deployed on Netlify (Netlify detects the
 * `data-netlify="true"` form at build time by scanning the generated
 * static HTML -- nothing to wire up server-side). If the operator sets
 * `siteConfig.forms.provider` to "endpoint" instead, the form posts to a
 * configured endpoint URL and the Netlify-only attributes are omitted.
 */
import { siteConfig } from '../config/site';
import { paths } from '../lib/urls';

interface Props {
  broadcastOptions: string[];
  cityOptions: string[];
}

const { broadcastOptions, cityOptions } = Astro.props;

const isNetlify = siteConfig.forms.provider === 'netlify';
const formAction = isNetlify
  ? paths.correctionThanks()
  : siteConfig.forms.correctionEndpointUrl || paths.correction();
---

<form
  name="duzeltme-bildirimi"
  method="POST"
  action={formAction}
  data-netlify={isNetlify ? 'true' : undefined}
  netlify-honeypot={isNetlify ? 'bot-field' : undefined}
  data-correction-form
  class="space-y-5"
>
  {isNetlify && <input type="hidden" name="form-name" value="duzeltme-bildirimi" />}
  {
    isNetlify && (
      <p class="hidden">
        <label>
          Bu alanı boş bırakın: <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>
    )
  }

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-broadcast" class="block text-sm font-medium text-ink">İlgili yayın</label>
      <input
        type="text"
        id="cf-broadcast"
        name="ilgili_yayin"
        list="cf-broadcast-options"
        placeholder="Örn: Show TV, Metro FM"
        class="mt-1.5 h-10 w-full rounded-md border border-border-strong bg-surface px-3 text-sm outline-none focus-visible:border-primary-600"
        data-correction-broadcast-input
      />
      <datalist id="cf-broadcast-options">
        {broadcastOptions.map((name) => <option value={name} />)}
      </datalist>
    </div>

    <div>
      <label for="cf-city" class="block text-sm font-medium text-ink">İlgili şehir</label>
      <input
        type="text"
        id="cf-city"
        name="ilgili_sehir"
        list="cf-city-options"
        placeholder="Örn: İstanbul"
        class="mt-1.5 h-10 w-full rounded-md border border-border-strong bg-surface px-3 text-sm outline-none focus-visible:border-primary-600"
      />
      <datalist id="cf-city-options">
        {cityOptions.map((name) => <option value={name} />)}
      </datalist>
    </div>
  </div>

  <div>
    <label for="cf-current" class="block text-sm font-medium text-ink">Mevcut bilgi</label>
    <textarea
      id="cf-current"
      name="mevcut_bilgi"
      rows="3"
      placeholder="Sitede şu anda gösterilen bilgi"
      class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm outline-none focus-visible:border-primary-600"
    ></textarea>
  </div>

  <div>
    <label for="cf-correction" class="block text-sm font-medium text-ink">
      Önerilen düzeltme <span aria-hidden="true">*</span>
      <span class="sr-only">(zorunlu)</span>
    </label>
    <textarea
      id="cf-correction"
      name="onerilen_duzeltme"
      rows="4"
      required
      placeholder="Doğru olduğunu düşündüğünüz bilgi"
      class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm outline-none focus-visible:border-primary-600"
    ></textarea>
  </div>

  <div>
    <label for="cf-source-url" class="block text-sm font-medium text-ink">Kaynak URL</label>
    <input
      type="url"
      id="cf-source-url"
      name="kaynak_url"
      placeholder="https://"
      class="mt-1.5 h-10 w-full rounded-md border border-border-strong bg-surface px-3 text-sm outline-none focus-visible:border-primary-600"
    />
  </div>

  <div>
    <label for="cf-description" class="block text-sm font-medium text-ink">Açıklama</label>
    <textarea
      id="cf-description"
      name="aciklama"
      rows="3"
      placeholder="Eklemek istediğiniz başka bir bilgi varsa"
      class="mt-1.5 w-full rounded-md border border-border-strong bg-surface px-3 py-2 text-sm outline-none focus-visible:border-primary-600"
    ></textarea>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class="block text-sm font-medium text-ink">Ad <span class="text-ink-faint">(isteğe bağlı)</span></label>
      <input
        type="text"
        id="cf-name"
        name="ad"
        class="mt-1.5 h-10 w-full rounded-md border border-border-strong bg-surface px-3 text-sm outline-none focus-visible:border-primary-600"
      />
    </div>
    <div>
      <label for="cf-email" class="block text-sm font-medium text-ink">
        E-posta <span class="text-ink-faint">(isteğe bağlı)</span>
      </label>
      <input
        type="email"
        id="cf-email"
        name="eposta"
        class="mt-1.5 h-10 w-full rounded-md border border-border-strong bg-surface px-3 text-sm outline-none focus-visible:border-primary-600"
      />
    </div>
  </div>

  <div class="flex items-start gap-2.5">
    <input
      type="checkbox"
      id="cf-privacy"
      name="gizlilik_onayi"
      value="evet"
      required
      class="mt-1 h-4 w-4 shrink-0 rounded border-border-strong"
    />
    <label for="cf-privacy" class="text-sm text-ink-muted">
      Gönderdiğim bilgilerin, düzeltme talebimi değerlendirmek amacıyla işleneceğini
      <a href={paths.privacy()} class="underline hover:text-primary-600">Gizlilik Politikası</a>
      kapsamında kabul ediyorum. <span aria-hidden="true">*</span>
      <span class="sr-only">(zorunlu)</span>
    </label>
  </div>

  <button
    type="submit"
    class="inline-flex items-center gap-2 rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700"
  >
    Düzeltme Bildir
  </button>
</form>

<script src="../scripts/correction-form-controller.ts"></script>
