---
/**
 * Affiliate "equipment" block for guides (antenna, satellite receiver,
 * LNB, radio...). Only rendered when at least one affiliate programme id
 * is configured; links are marked rel="sponsored" and disclosed.
 */
import { siteConfig } from '../config/site';

interface Props {
  /** Search keywords, e.g. ["uydu alıcısı", "çanak anten"]. */
  items: { label: string; query: string }[];
}

const { items } = Astro.props;
const { amazonTag, hepsiburadaId, trendyolId } = siteConfig.affiliate;

function links(query: string) {
  const q = encodeURIComponent(query);
  return [
    amazonTag && { store: 'Amazon', href: `https://www.amazon.com.tr/s?k=${q}&tag=${encodeURIComponent(amazonTag)}` },
    hepsiburadaId && { store: 'Hepsiburada', href: `https://www.hepsiburada.com/ara?q=${q}&wt_af=${encodeURIComponent(hepsiburadaId)}` },
    trendyolId && { store: 'Trendyol', href: `https://www.trendyol.com/sr?q=${q}&boutiqueId=61&afId=${encodeURIComponent(trendyolId)}` },
  ].filter((x): x is { store: string; href: string } => Boolean(x));
}
const enabled = Boolean(amazonTag || hepsiburadaId || trendyolId);
---

{
  enabled && items.length > 0 && (
    <aside class="my-10 rounded-xl border border-border bg-surface p-5" aria-label="Önerilen ekipman">
      <p class="font-display text-lg font-bold text-ink">Bu rehber için gerekli ekipman</p>
      <ul class="mt-3 divide-y divide-border">
        {items.map((item) => (
          <li class="flex flex-wrap items-center justify-between gap-2 py-2.5">
            <span class="text-ink">{item.label}</span>
            <span class="flex gap-2">
              {links(item.query).map((l) => (
                <a href={l.href} target="_blank" rel="sponsored nofollow noopener" class="rounded-full border border-border-strong px-3 py-1 text-sm text-ink hover:border-ink">
                  {l.store} ↗
                </a>
              ))}
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-ink-faint">Bu bağlantılar üzerinden yapılan alışverişlerden Frekanslar komisyon alabilir; fiyat size değişmez.</p>
    </aside>
  )
}
