---
/**
 * Visible breadcrumb trail. Pages are responsible for also passing the
 * same trail into `breadcrumbListSchema()` for JSON-LD -- this component
 * only renders the on-page nav so the two never silently drift, callers
 * build both from one array.
 */
import { ChevronRight } from '@lucide/astro';

export interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-ink-faint">
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="flex items-center gap-1">
            {index > 0 && <ChevronRight class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />}
            {isLast ? (
              <span aria-current="page" class="font-medium text-ink">
                {item.name}
              </span>
            ) : (
              <a href={item.href} class="rounded hover:text-primary-600 hover:underline">
                {item.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
