---
/**
 * Generic "related content" block -- used for "İlgili radyo istasyonları",
 * "İlgili kanallar", "Komşu şehirler" etc. Keeps the internal link graph
 * (city -> radio -> frequency -> city, channel -> satellite -> transponder)
 * visible in the actual page content, not just in the breadcrumb.
 */
interface RelatedItem {
  name: string;
  href: string;
  meta?: string;
}

interface Props {
  title: string;
  items: RelatedItem[];
}

const { title, items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-10">
      <h2 class="text-xl font-bold text-ink">{title}</h2>
      <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex items-center justify-between gap-2 rounded-md border border-border bg-surface px-4 py-2.5 text-sm hover:border-primary-600"
            >
              <span class="font-medium text-ink">{item.name}</span>
              {item.meta && <span class="text-ink-faint">{item.meta}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
