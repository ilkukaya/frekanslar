---
import { paths } from '../lib/urls';
import { formatDateTr } from '../lib/format';

interface Props {
  slug: string;
  title: string;
  description: string;
  updatedDate: string;
}

const { slug, title, description, updatedDate } = Astro.props;
---

<a
  href={paths.guide(slug)}
  class="group flex h-full flex-col rounded-xl border border-border bg-surface p-5 transition-colors hover:border-ink"
>
  <p class="text-xs font-semibold uppercase tracking-wider text-primary-600">Rehber</p>
  <p class="mt-2 font-display text-lg font-bold leading-snug text-ink group-hover:underline">{title}</p>
  <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-muted">{description}</p>
  <p class="mt-auto pt-4 text-xs text-ink-faint">Güncellendi: {formatDateTr(updatedDate)}</p>
</a>
