---
/**
 * Brand logo slot for a station/channel.
 *
 * Resolution order:
 *  1. `logo` -- a verified logo asset shipped with the site (/logos/...).
 *  2. The icon published by the brand's own official website, requested
 *     from Google's public favicon service at display time. Nothing is
 *     copied or re-hosted; tiny/missing icons (< 48px, e.g. the generic
 *     globe) are discarded client-side so we never show a blurry stand-in.
 *  3. A typographic monogram tinted with a stable per-brand hue.
 *
 * The monogram is always rendered underneath, so a slow or blocked icon
 * request never leaves an empty box.
 */
import { brandInitials, brandHue } from '../lib/brand-visual';

interface Props {
  name: string;
  logo?: string | null;
  website?: string | null;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { name, logo = null, website = null, size = 'md', class: className = '' } = Astro.props;

const initials = brandInitials(name);
const hue = brandHue(name);

let iconSrc: string | null = null;
if (!logo && website) {
  try {
    const host = new URL(website).hostname;
    iconSrc = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=128`;
  } catch {
    iconSrc = null;
  }
}

const SIZE_CLASSES: Record<typeof size, string> = {
  sm: 'h-9 w-9 rounded-md text-[0.7rem]',
  md: 'h-12 w-12 rounded-lg text-sm',
  lg: 'h-16 w-16 rounded-xl text-lg',
  xl: 'h-24 w-24 rounded-2xl text-2xl',
};
const PX: Record<typeof size, number> = { sm: 36, md: 48, lg: 64, xl: 96 };
const longInitials = initials.length > 2;
---

<span
  class:list={['brand-mono relative inline-flex shrink-0 items-center justify-center overflow-hidden font-display font-extrabold tracking-tight', SIZE_CLASSES[size], className]}
  style={`--h:${hue}`}
  role="img"
  aria-label={`${name} logosu`}
>
  <span aria-hidden="true" class:list={[{ 'text-[0.72em]': longInitials }]}>{initials}</span>
  {
    logo ? (
      <img
        src={logo}
        alt=""
        width={PX[size]}
        height={PX[size]}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full bg-white object-contain p-1.5"
      />
    ) : (
      iconSrc && (
        <img
          src={iconSrc}
          alt=""
          width={PX[size]}
          height={PX[size]}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class="absolute inset-0 h-full w-full bg-white object-contain p-[18%]"
          onload="if(this.naturalWidth<48)this.remove()"
          onerror="this.remove()"
        />
      )
    )
  }
</span>

<style is:global>
  .brand-mono {
    background: hsl(var(--h) 55% 93%);
    color: hsl(var(--h) 55% 28%);
    box-shadow: inset 0 0 0 1px hsl(var(--h) 30% 80% / 0.6);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .brand-mono {
      background: hsl(var(--h) 25% 18%);
      color: hsl(var(--h) 60% 80%);
      box-shadow: inset 0 0 0 1px hsl(var(--h) 20% 30% / 0.8);
    }
  }
  :root[data-theme='dark'] .brand-mono {
    background: hsl(var(--h) 25% 18%);
    color: hsl(var(--h) 60% 80%);
    box-shadow: inset 0 0 0 1px hsl(var(--h) 20% 30% / 0.8);
  }
</style>
