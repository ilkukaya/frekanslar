---
/**
 * Safe fallback whenever a station/channel has no verified logo asset:
 * an initials badge, never a broken <img> and never a fetched-at-random
 * stand-in image.
 */
interface Props {
  name: string;
  logo?: string | null;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { name, logo = null, size = 'md', class: className = '' } = Astro.props;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word.charAt(0).toUpperCase())
  .join('');

const SIZE_CLASSES: Record<typeof size, string> = {
  sm: 'h-9 w-9 text-xs',
  md: 'h-12 w-12 text-sm',
  lg: 'h-16 w-16 text-lg',
};
---

{
  logo ? (
    <img
      src={logo}
      alt={`${name} logosu`}
      width="64"
      height="64"
      loading="lazy"
      class:list={['rounded-md border border-border object-contain bg-surface', SIZE_CLASSES[size], className]}
    />
  ) : (
    <span
      role="img"
      aria-label={`${name} için logo bulunmuyor`}
      class:list={[
        'inline-flex shrink-0 items-center justify-center rounded-md border border-border bg-surface-muted font-semibold text-ink-muted',
        SIZE_CLASSES[size],
        className,
      ]}
    >
      {initials || '—'}
    </span>
  )
}
