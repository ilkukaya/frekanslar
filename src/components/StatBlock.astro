---
interface Stat {
  label: string;
  value: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
  {
    stats.map((stat) => (
      <div class="rounded-lg border border-border bg-surface p-4 text-center shadow-card">
        <dt class="text-xs font-medium uppercase tracking-wide text-ink-faint">{stat.label}</dt>
        <dd class="mt-1 text-2xl font-bold text-ink">{stat.value}</dd>
      </div>
    ))
  }
</dl>
