---
import { MapPin } from '@lucide/astro';
import { paths } from '../lib/urls';
import type { City } from '../data/schemas';

interface Props {
  city: City;
  radioCount?: number;
}

const { city, radioCount } = Astro.props;
---

<a
  href={paths.city(city.slug)}
  class="flex items-center gap-3 rounded-lg border border-border bg-surface p-4 shadow-card transition-colors hover:border-primary-600"
>
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-surface-muted text-ink-muted">
    <MapPin class="h-5 w-5" aria-hidden="true" />
  </span>
  <div class="min-w-0">
    <p class="truncate font-semibold text-ink">{city.name}</p>
    <p class="truncate text-sm text-ink-muted">
      Plaka {city.plateCode}
      {typeof radioCount === 'number' && ` · ${radioCount} radyo`}
    </p>
  </div>
</a>
