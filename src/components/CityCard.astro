---
import { paths } from '../lib/urls';
import type { City } from '../data/schemas';

interface Props {
  city: City;
  radioCount?: number;
}

const { city, radioCount } = Astro.props;
---

<a
  href={paths.city(city.slug)}
  class="group flex items-center gap-3 rounded-lg border border-border bg-surface px-3 py-2.5 transition-colors hover:border-ink"
>
  <span class="num flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-surface-muted text-sm font-bold text-ink-muted group-hover:bg-ink group-hover:text-surface">
    {String(city.plateCode).padStart(2, '0')}
  </span>
  <div class="min-w-0">
    <p class="truncate font-semibold text-ink">{city.name}</p>
    {typeof radioCount === 'number' && <p class="truncate text-xs text-ink-faint">{radioCount} radyo</p>}
  </div>
</a>
