---
/**
 * The "veri kartı" pattern used across profile pages: a single fact shown
 * with its value, unit, context, verification status and source -- so an
 * AI answer engine or a skimming reader gets the full provenance without
 * following a link.
 */
import SourceList from './SourceList.astro';
import VerificationBadge from './VerificationBadge.astro';
import { formatDateTr } from '../lib/format';
import type { Source, VerificationStatus } from '../data/schemas';

interface Props {
  label: string;
  value: string;
  unit?: string;
  context?: string;
  lastVerifiedAt: string;
  verificationStatus: VerificationStatus;
  sources: Source[];
}

const { label, value, unit, context, lastVerifiedAt, verificationStatus, sources } = Astro.props;
---

<div class="rounded-lg border border-border bg-surface p-4 shadow-card">
  <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">{label}</p>
  <p class="mt-1 text-2xl font-bold text-ink">
    {value}
    {unit && <span class="ml-1 text-base font-medium text-ink-muted">{unit}</span>}
  </p>
  {context && <p class="mt-0.5 text-sm text-ink-muted">{context}</p>}
  <div class="mt-3 flex flex-col gap-1.5 border-t border-border pt-3">
    <VerificationBadge status={verificationStatus} compact />
    <p class="text-xs text-ink-faint">
      Son kontrol: <time datetime={lastVerifiedAt}>{formatDateTr(lastVerifiedAt)}</time>
    </p>
    <SourceList sources={sources} />
  </div>
</div>
