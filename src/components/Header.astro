---
import { Menu, Radio, X } from '@lucide/astro';
import SearchBox from './SearchBox.astro';
import { paths } from '../lib/urls';
import { siteConfig } from '../config/site';

const navItems = [
  { name: 'Radyo Frekansları', href: paths.radioList() },
  { name: 'Televizyon Kanalları', href: paths.tvList() },
  { name: 'Uydu Frekansları', href: paths.satelliteList() },
  { name: 'Rehber', href: paths.guideList() },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-border bg-surface">
  <div class="mx-auto flex max-w-(--container-content) flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
    <a href={paths.home()} class="flex shrink-0 items-center gap-2 text-lg font-bold text-ink">
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-primary-600 text-white">
        <Radio class="h-4.5 w-4.5" aria-hidden="true" />
      </span>
      {siteConfig.siteName}
    </a>

    <nav aria-label="Ana menü" class="hidden md:flex md:flex-1 md:items-center md:gap-1">
      {
        navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium text-ink-muted hover:bg-surface-subtle hover:text-ink',
                { 'bg-surface-subtle text-ink': isActive },
              ]}
            >
              {item.name}
            </a>
          );
        })
      }
    </nav>

    <div class="order-last w-full md:order-none md:ml-auto md:w-80">
      <SearchBox />
    </div>

    <details class="group ml-auto md:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-md border border-border px-3 py-2 text-sm font-medium text-ink [&::-webkit-details-marker]:hidden">
        <Menu class="h-4.5 w-4.5 group-open:hidden" aria-hidden="true" />
        <X class="hidden h-4.5 w-4.5 group-open:block" aria-hidden="true" />
        Menü
      </summary>
      <nav aria-label="Ana menü (mobil)" class="mt-3 flex w-full flex-col gap-1 border-t border-border pt-3">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-ink-muted hover:bg-surface-subtle hover:text-ink"
            >
              {item.name}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
