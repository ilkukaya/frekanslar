---
import { Moon, Search, Sun } from '@lucide/astro';
import SearchBox from './SearchBox.astro';
import SiteLogo from './SiteLogo.astro';
import { paths } from '../lib/urls';

const navItems = [
  { name: 'Radyolar', href: paths.radioDirectory() },
  { name: 'Şehirler', href: paths.radioList() },
  { name: 'TV Kanalları', href: paths.tvList() },
  { name: 'Uydu', href: paths.satelliteList() },
  { name: 'Kuruluşlar', href: paths.broadcasterList() },
  { name: 'Rehber', href: paths.guideList() },
];

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
---

<header class="sticky top-0 z-40 border-b border-border bg-surface/90 backdrop-blur supports-[backdrop-filter]:bg-surface/80">
  <div class="mx-auto flex h-16 max-w-(--container-content) items-center gap-4 px-4 sm:px-6">
    <a href={paths.home()} class="shrink-0" aria-label="Frekanslar ana sayfa">
      <SiteLogo />
    </a>

    <nav aria-label="Ana menü" class="hidden lg:flex lg:items-center lg:gap-0.5">
      {
        navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'relative rounded-md px-3 py-2 text-[0.9rem] font-medium transition-colors',
                isActive ? 'text-ink' : 'text-ink-muted hover:text-ink',
              ]}
            >
              {item.name}
              {isActive && <span class="absolute inset-x-3 -bottom-[13px] h-0.5 rounded-full bg-primary-600" />}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      {
        !isHome && (
          <div class="hidden w-72 md:block xl:w-80">
            <SearchBox />
          </div>
        )
      }
      <a
        href={paths.search()}
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-ink-muted hover:bg-surface-muted hover:text-ink md:hidden"
        aria-label="Ara"
      >
        <Search class="h-5 w-5" aria-hidden="true" />
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-ink-muted hover:bg-surface-muted hover:text-ink"
        aria-label="Açık/koyu tema"
        data-theme-toggle
      >
        <Moon class="h-5 w-5 dark-hide" aria-hidden="true" />
        <Sun class="h-5 w-5 light-hide" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<style is:global>
  .light-hide {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .light-hide {
      display: block;
    }
    :root:not([data-theme='light']) .dark-hide {
      display: none;
    }
  }
  :root[data-theme='dark'] .light-hide {
    display: block;
  }
  :root[data-theme='dark'] .dark-hide {
    display: none;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable (private mode) -- theme still applies for this page */
    }
  });
</script>
