---
/**
 * Site-wide HTML shell: skip link, sample-data banner, header, footer,
 * global styles, SEO tags and the analytics bootstrap. Every page in
 * `src/pages/` renders through this layout.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SampleDataBanner from '../components/SampleDataBanner.astro';
import SEO from '../components/SEO.astro';
import { siteConfig } from '../config/site';
import { analyticsRuntimeConfig } from '../lib/analytics';
import type { JsonLdObject } from '../lib/seo/jsonld';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of this page, e.g. "/radyo/metro-fm/". */
  path: string;
  robots?: 'index,follow' | 'noindex,follow' | 'noindex,nofollow';
  ogType?: 'website' | 'article';
  lastUpdated?: string;
  jsonLd?: JsonLdObject | JsonLdObject[];
}

const { title, description, path, robots, ogType, lastUpdated, jsonLd } = Astro.props;
const analyticsConfig = analyticsRuntimeConfig();
---

<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1d4ed8" />
    <SEO
      title={title}
      description={description}
      path={path}
      robots={robots}
      ogType={ogType}
      lastUpdated={lastUpdated}
      jsonLd={jsonLd}
    />
    <script src="../scripts/analytics-client.ts"></script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-surface-subtle text-ink antialiased"
    data-analytics-provider={analyticsConfig.provider}
    data-analytics-domain={analyticsConfig.domain}
  >
    <a href="#main-content" class="skip-link">İçeriğe geç</a>
    <SampleDataBanner />
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
