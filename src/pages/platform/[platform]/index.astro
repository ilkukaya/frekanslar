---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import VerificationBadge from '../../../components/VerificationBadge.astro';
import SourceList from '../../../components/SourceList.astro';
import { PLATFORM_TYPE_LABELS } from '../../../lib/labels';
import { formatDateTr } from '../../../lib/format';
import { byId, platformChannelsByPlatform, sourcesByIds } from '../../../lib/relations';
import { canonicalUrl, paths } from '../../../lib/urls';
import { breadcrumbListSchema, webPageSchema } from '../../../lib/seo/jsonld';

export const getStaticPaths = (async () => {
  const [platformEntries, platformChannelEntries, channelEntries, sourceEntries] = await Promise.all([
    getCollection('platforms'),
    getCollection('platform-channels'),
    getCollection('television-channels'),
    getCollection('sources'),
  ]);

  const platforms = platformEntries.map((e) => e.data);
  const platformChannels = platformChannelEntries.map((e) => e.data);
  const channels = channelEntries.map((e) => e.data);
  const sources = sourceEntries.map((e) => e.data);

  return platforms.map((platform) => ({
    params: { platform: platform.slug },
    props: {
      platform,
      entries: platformChannelsByPlatform(platformChannels, platform.id).sort((a, b) => a.channelNumber - b.channelNumber),
      channels,
      sources,
    },
  }));
}) satisfies GetStaticPaths;

const { platform, entries, channels, sources } = Astro.props;
const platformSources = sourcesByIds(sources, platform.sourceIds);

const pagePath = paths.platform(platform.slug);
const pageTitle = `${platform.name} Kanal Listesi ve Kanal Numaraları`;
const pageDescription = `${platform.name} platformunda yer alan televizyon kanalları ve güncel kanal numaraları.`;

const breadcrumbItems = [
  { name: 'Ana Sayfa', href: paths.home() },
  { name: 'Uydu Frekansları', href: paths.satelliteList() },
  { name: platform.name, href: pagePath },
];

const jsonLd = [
  webPageSchema({ name: pageTitle, description: pageDescription, url: canonicalUrl(pagePath), dateModified: platform.lastVerifiedAt }),
  breadcrumbListSchema(breadcrumbItems.map((item) => ({ name: item.name, url: canonicalUrl(item.href) }))),
];
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} lastUpdated={platform.lastVerifiedAt} jsonLd={jsonLd} robots={entries.length === 0 ? 'noindex,follow' : 'index,follow'}>
  <div class="mx-auto max-w-(--container-content) px-4 py-6 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 text-2xl font-bold text-ink sm:text-3xl">{platform.name}</h1>
    <p class="mt-1 text-sm text-ink-muted">
      {PLATFORM_TYPE_LABELS[platform.platformType]}
      {platform.operator && ` · ${platform.operator}`}
    </p>
    <div class="mt-2">
      <VerificationBadge status={platform.verificationStatus} lastVerifiedAt={platform.lastVerifiedAt} />
    </div>

    <p class="mt-6 max-w-3xl text-ink-muted">{platform.description}</p>

    {
      platform.officialWebsite && (
        <a
          href={platform.officialWebsite}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex w-fit items-center gap-2 rounded-md border border-border-strong px-4 py-2.5 text-sm font-semibold text-ink hover:bg-surface-subtle"
        >
          Resmî Web Sitesine Git
        </a>
      )
    }

    <section class="mt-10">
      <h2 class="text-xl font-bold text-ink">Kanal Listesi</h2>
      {
        entries.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted">Bu platform için henüz kayıtlı bir kanal numarası bulunmuyor.</p>
        ) : (
          <div class="mt-4 overflow-x-auto rounded-lg border border-border" tabindex="0">
            <table class="responsive-table w-full border-collapse text-sm">
              <caption class="sr-only">{platform.name} kanal listesi</caption>
              <thead class="bg-surface-subtle text-left">
                <tr>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Kanal No</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Kanal</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Paket</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Son kontrol</th>
                </tr>
              </thead>
              <tbody>
                {entries.map((entry) => {
                  const channel = byId(channels, entry.channelId);
                  return (
                    <tr>
                      <td data-label="Kanal No" class="border-t border-border px-3 py-2.5 font-mono font-medium text-ink">{entry.channelNumber}</td>
                      <td data-label="Kanal" class="border-t border-border px-3 py-2.5">
                        {channel ? <a href={paths.televisionChannel(channel.slug)} class="text-primary-600 hover:underline">{channel.name}</a> : entry.channelId}
                      </td>
                      <td data-label="Paket" class="border-t border-border px-3 py-2.5 text-ink-muted">{entry.packageName ?? '—'}</td>
                      <td data-label="Son kontrol" class="border-t border-border px-3 py-2.5 text-ink-faint">
                        <time datetime={entry.lastVerifiedAt}>{formatDateTr(entry.lastVerifiedAt)}</time>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-ink">Veri Kaynakları ve Doğrulama</h2>
      <div class="mt-3 rounded-lg border border-border bg-surface p-4">
        <VerificationBadge status={platform.verificationStatus} lastVerifiedAt={platform.lastVerifiedAt} />
        <div class="mt-2">
          <SourceList sources={platformSources} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
