---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SatelliteCard from '../../components/SatelliteCard.astro';
import { servicesBySatellite, sortByName, transpondersBySatellite } from '../../lib/relations';
import { canonicalUrl, paths } from '../../lib/urls';
import { breadcrumbListSchema, collectionPageSchema } from '../../lib/seo/jsonld';

const [satelliteEntries, transponderEntries, serviceEntries] = await Promise.all([
  getCollection('satellites'),
  getCollection('transponders'),
  getCollection('satellite-services'),
]);

const satellites = sortByName(satelliteEntries.map((e) => e.data));
const transponders = transponderEntries.map((e) => e.data);
const services = serviceEntries.map((e) => e.data);

const pagePath = paths.satelliteList();
const pageTitle = 'Türkiye Uydu Frekansları: Türksat Uyduları ve Kanal Ayarları';
const pageDescription = `Türkiye'de radyo ve televizyon yayınlarının dağıtıldığı ${satellites.length} uydunun yörünge konumu, transponderleri ve taşıdığı kanallar.`;

const breadcrumbItems = [
  { name: 'Ana Sayfa', href: paths.home() },
  { name: 'Uydu Frekansları', href: pagePath },
];

const jsonLd = [
  breadcrumbListSchema(breadcrumbItems.map((item) => ({ name: item.name, url: canonicalUrl(item.href) }))),
  collectionPageSchema({
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl(pagePath),
    items: satellites.map((satellite) => ({ name: satellite.name, url: canonicalUrl(paths.satellite(satellite.slug)) })),
  }),
];
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} jsonLd={jsonLd}>
  <div class="mx-auto max-w-(--container-content) px-4 py-6 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 text-2xl font-bold text-ink sm:text-3xl">Türkiye Uydu Frekansları</h1>
    <p class="mt-2 max-w-2xl text-ink-muted">
      Türkiye'de yayın yapan ulusal televizyon ve radyo kanallarının büyük bölümü Türksat uydu ailesi üzerinden
      şifresiz olarak dağıtılır. Türksat 3A, 4A, 5B ve 6A aynı 42° Doğu konumunda bulunduğu için tek bir çanak
      ayarıyla bu uyduların tamamındaki yayınlar alınabilir.
    </p>
    <div class="mt-6 rounded-xl border border-border bg-surface p-5 text-sm leading-relaxed text-ink-muted">
      <p class="font-display text-base font-bold text-ink">Transponder listeleri doğrulanıyor</p>
      <p class="mt-1">
        Frekanslar'da yalnızca doğrulanmış teknik değerler yayımlanır. Uydu transponder (frekans, polarizasyon,
        sembol oranı) tabloları, operatör kaynaklarıyla karşılaştırıldıkça bu sayfaya eklenecek. O zamana kadar
        kanalları bulmanın en hızlı yolu alıcınızda otomatik (kör) arama yapmaktır:
      </p>
      <ul class="mt-3 flex flex-wrap gap-2">
        <li><a href={paths.guide('canak-anten-ayari-turksat')} class="inline-block rounded-full border border-border-strong px-3 py-1.5 text-ink hover:border-ink">Çanak anten Türksat ayarı</a></li>
        <li><a href={paths.guide('otomatik-kanal-aramasi-nasil-yapilir')} class="inline-block rounded-full border border-border-strong px-3 py-1.5 text-ink hover:border-ink">Otomatik kanal arama</a></li>
        <li><a href={paths.guide('sinyal-yok-hatasi-cozumu')} class="inline-block rounded-full border border-border-strong px-3 py-1.5 text-ink hover:border-ink">"Sinyal yok" çözümü</a></li>
        <li><a href={paths.guide('lnb-nedir-cesitleri')} class="inline-block rounded-full border border-border-strong px-3 py-1.5 text-ink hover:border-ink">LNB çeşitleri</a></li>
      </ul>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        satellites.map((satellite) => {
          const transponderCount = transpondersBySatellite(transponders, satellite.id).length;
          const serviceCount = servicesBySatellite(services, satellite.id).length;
          return (
            <SatelliteCard
              satellite={satellite}
              meta={transponderCount > 0 ? `${satellite.orbitalPosition} · ${transponderCount} transponder · ${serviceCount} kanal` : `${satellite.orbitalPosition}${satellite.launchDate ? ` · fırlatma ${satellite.launchDate.slice(0, 4)}` : ''}`}
            />
          );
        })
      }
    </div>
  </div>
</BaseLayout>
