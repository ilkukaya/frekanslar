---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FrequencyTable, { type FrequencyTableRow } from '../../../components/FrequencyTable.astro';
import BrandCard from '../../../components/BrandCard.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import FAQSection from '../../../components/FAQSection.astro';
import { formatDateTr } from '../../../lib/format';
import { CHANGE_TYPE_LABELS } from '../../../lib/labels';
import { generateCityFaqs } from '../../../lib/faq-generator';
import {
  districtsByCity,
  frequenciesByCity,
  mostRecentlyVerified,
  neighborCities,
  stationsActiveInCity,
  transmittersByCity,
} from '../../../lib/relations';
import { canonicalUrl, paths } from '../../../lib/urls';
import { breadcrumbListSchema, collectionPageSchema, datasetSchema, faqPageSchema } from '../../../lib/seo/jsonld';

export const getStaticPaths = (async () => {
  const [cityEntries, districtEntries, stationEntries, frequencyEntries, transmitterEntries, updateEntries] =
    await Promise.all([
      getCollection('cities'),
      getCollection('districts'),
      getCollection('radio-stations'),
      getCollection('terrestrial-frequencies'),
      getCollection('transmitters'),
      getCollection('frequency-updates'),
    ]);

  const cities = cityEntries.map((e) => e.data);
  const districts = districtEntries.map((e) => e.data);
  const stations = stationEntries.map((e) => e.data);
  const frequencies = frequencyEntries.map((e) => e.data);
  const transmitters = transmitterEntries.map((e) => e.data);
  const updates = updateEntries.map((e) => e.data);

  return cities.map((city) => {
    const cityFrequencies = frequenciesByCity(frequencies, city.id).filter((f) => f.status === 'active');
    const activeStations = stationsActiveInCity(stations, frequencies, city.id);
    const cityDistricts = districtsByCity(districts, city.id);
    const cityTransmitters = transmittersByCity(transmitters, city.id);
    const cityUpdates = updates
      .filter((u) => u.cityId === city.id)
      .sort((a, b) => b.date.localeCompare(a.date));

    return {
      params: { il: city.slug },
      props: {
        city,
        cities,
        cityFrequencies,
        activeStations,
        cityDistricts,
        cityTransmitters,
        cityUpdates,
        stations,
      },
    };
  });
}) satisfies GetStaticPaths;

const { city, cities, cityFrequencies, activeStations, cityDistricts, cityTransmitters, cityUpdates, stations } =
  Astro.props;

const stationById = new Map(stations.map((s) => [s.id, s]));

const nationalCount = activeStations.filter((s) => s.coverageType === 'national').length;
const regionalCount = activeStations.filter((s) => s.coverageType === 'regional').length;
const localCount = activeStations.filter((s) => s.coverageType === 'local').length;

const tableRows: FrequencyTableRow[] = cityFrequencies
  .map((freq): FrequencyTableRow | null => {
    const station = stationById.get(freq.stationId);
    if (!station) return null;
    const district = cityDistricts.find((d) => d.id === freq.districtId);
    const transmitter = cityTransmitters.find((t) => t.id === freq.transmitterId);
    return {
      id: freq.id,
      frequency: freq.frequency,
      unit: freq.unit,
      stationName: station.name,
      stationHref: paths.radioStationCity(station.slug, city.slug),
      broadcastType: station.broadcastType,
      coverageType: freq.coverageType,
      districtOrTransmitter: district?.name ?? transmitter?.name ?? null,
      status: freq.status,
      lastVerifiedAt: freq.lastVerifiedAt,
    };
  })
  .filter((row): row is FrequencyTableRow => row !== null)
  .sort((a, b) => a.frequency - b.frequency);

const neighbors = neighborCities(cities, city, 4);
const popularStations = activeStations.filter((s) => s.featured).slice(0, 4);
const latestVerifiedAt = mostRecentlyVerified(cityFrequencies, 1)[0]?.lastVerifiedAt ?? null;
const faqs = generateCityFaqs(city, activeStations.length, cityFrequencies);

const pagePath = paths.city(city.slug);
const pageTitle = `${city.name} Radyo Frekansları: Güncel FM Listesi`;
const pageDescription = `${city.name} ilinde FM frekansında yayın yapan ${activeStations.length} radyo istasyonunun güncel frekans, verici ve doğrulama bilgileri.`;

const breadcrumbItems = [
  { name: 'Ana Sayfa', href: paths.home() },
  { name: 'Radyo Frekansları', href: paths.radioList() },
  { name: city.name, href: pagePath },
];

const jsonLd = [
  breadcrumbListSchema(breadcrumbItems.map((item) => ({ name: item.name, url: canonicalUrl(item.href) }))),
  collectionPageSchema({
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl(pagePath),
    items: tableRows.map((row) => ({ name: `${row.stationName} — ${row.frequency} ${row.unit}`, url: canonicalUrl(row.stationHref) })),
    dateModified: latestVerifiedAt ?? undefined,
  }),
  ...(latestVerifiedAt
    ? [
        datasetSchema({
          name: `${city.name} Radyo Frekansları Veri Seti`,
          description: pageDescription,
          url: canonicalUrl(pagePath),
          dateModified: latestVerifiedAt,
        }),
      ]
    : []),
  ...(faqs.length > 0 ? [faqPageSchema(faqs)] : []),
];
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} lastUpdated={latestVerifiedAt ?? undefined} jsonLd={jsonLd}>
  <div class="mx-auto max-w-(--container-content) px-4 py-6 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 text-2xl font-bold text-ink sm:text-3xl">{city.name} Radyo Frekansları</h1>

    <div class="mt-6 rounded-lg border border-primary-100 bg-primary-50 p-4">
      <p class="text-sm font-semibold text-primary-700">{city.name}'de kaç radyo istasyonu yayın yapıyor?</p>
      <p class="mt-1 text-ink">
        {city.name} ilinde Frekanslar'da doğrulanmış kayıtlara göre {activeStations.length} radyo istasyonu FM
        frekansında yayın yapıyor.
      </p>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-lg border border-border bg-surface p-4 text-center">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Toplam Radyo</p>
        <p class="mt-1 text-xl font-bold text-ink">{activeStations.length}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-4 text-center">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Ulusal</p>
        <p class="mt-1 text-xl font-bold text-ink">{nationalCount}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-4 text-center">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Bölgesel</p>
        <p class="mt-1 text-xl font-bold text-ink">{regionalCount}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-4 text-center">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Yerel</p>
        <p class="mt-1 text-xl font-bold text-ink">{localCount}</p>
      </div>
    </div>

    {
      popularStations.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-ink">{city.name}'deki Popüler Radyolar</h2>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {popularStations.map((station) => (
              <BrandCard brand={station} kind="radio" meta={`${city.name} üzerinden dinle`} />
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-10">
      <h2 class="text-xl font-bold text-ink">Frekans Tablosu</h2>
      {
        tableRows.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted">Bu şehir için henüz doğrulanmış bir frekans kaydı bulunmuyor.</p>
        ) : (
          <div class="mt-4">
            <FrequencyTable rows={tableRows} caption={`${city.name} radyo frekansları tablosu`} showDistrictFilter={cityDistricts.length > 0} />
          </div>
        )
      }
    </section>

    {
      cityTransmitters.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-ink">Verici Bölgesi Bilgisi</h2>
          <ul class="mt-3 space-y-2">
            {cityTransmitters.map((transmitter) => (
              <li class="rounded-md border border-border bg-surface px-4 py-3 text-sm">
                <span class="font-medium text-ink">{transmitter.name}</span>
                {transmitter.elevationMeters && <span class="text-ink-muted"> · {transmitter.elevationMeters} m</span>}
                {transmitter.notes && <p class="mt-1 text-ink-muted">{transmitter.notes}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      cityUpdates.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-ink">En Son Güncellenen Frekanslar</h2>
          <ul class="mt-4 divide-y divide-border rounded-lg border border-border bg-surface">
            {cityUpdates.map((update) => (
              <li>
                <a href={paths.update(update.slug)} class="flex flex-col gap-1 px-4 py-3 hover:bg-surface-subtle sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <p class="font-medium text-ink">{update.title}</p>
                    <p class="text-sm text-ink-muted">{CHANGE_TYPE_LABELS[update.changeType]}</p>
                  </div>
                  <time datetime={update.date} class="text-xs text-ink-faint">{formatDateTr(update.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <RelatedLinks
      title="Komşu Şehirler"
      items={neighbors.map((n) => ({ name: n.name, href: paths.city(n.slug) }))}
    />

    <FAQSection faqs={faqs} />

    {
      latestVerifiedAt && (
        <p class="mt-8 text-sm text-ink-faint">
          Son doğrulama: <time datetime={latestVerifiedAt}>{formatDateTr(latestVerifiedAt)}</time>. Bilgi hatalıysa{' '}
          <a href={`${paths.correction()}?ilgili_sehir=${encodeURIComponent(city.name)}`} class="text-primary-600 underline hover:no-underline">
            düzeltme bildirin
          </a>
          .
        </p>
      )
    }
  </div>
</BaseLayout>
