---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CityCard from '../../components/CityCard.astro';
import BrandCard from '../../components/BrandCard.astro';
import { sortByName, stationsActiveInCity } from '../../lib/relations';
import { canonicalUrl, paths } from '../../lib/urls';
import { breadcrumbListSchema, collectionPageSchema } from '../../lib/seo/jsonld';

const [cityEntries, stationEntries, frequencyEntries] = await Promise.all([
  getCollection('cities'),
  getCollection('radio-stations'),
  getCollection('terrestrial-frequencies'),
]);

const cities = sortByName(cityEntries.map((e) => e.data));
const stations = sortByName(stationEntries.map((e) => e.data));
const frequencies = frequencyEntries.map((e) => e.data);

const pagePath = paths.radioList();
const pageTitle = 'Türkiye Radyo Frekansları: Şehre ve İstasyona Göre Güncel Liste';
const pageDescription = `Türkiye genelinde ${cities.length} şehirdeki radyo frekanslarını ve ${stations.length} radyo istasyonunun güncel FM bilgilerini şehir veya istasyon adına göre bulun.`;

const breadcrumbItems = [
  { name: 'Ana Sayfa', href: paths.home() },
  { name: 'Radyo Frekansları', href: pagePath },
];

const jsonLd = [
  breadcrumbListSchema(breadcrumbItems.map((item) => ({ name: item.name, url: canonicalUrl(item.href) }))),
  collectionPageSchema({
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl(pagePath),
    items: cities.map((city) => ({ name: city.name, url: canonicalUrl(paths.city(city.slug)) })),
  }),
];
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} jsonLd={jsonLd}>
  <div class="mx-auto max-w-(--container-content) px-4 py-6 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 text-3xl text-ink sm:text-4xl">Şehre Göre Radyo Frekansları</h1>
    <p class="mt-2 max-w-2xl text-ink-muted">
      {cities.length} şehirdeki güncel FM frekanslarını şehre göre inceleyin veya {stations.length} radyo
      istasyonundan birinin profiline gidin.
    </p>

    <section class="mt-8">
      <h2 class="text-xl font-bold text-ink">Şehre Göre Radyo Frekansları</h2>
      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          cities.map((city) => (
            <CityCard city={city} radioCount={stationsActiveInCity(stations, frequencies, city.id).length} />
          ))
        }
      </div>
    </section>

    <section class="mt-10">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-xl font-bold text-ink">Ulusal Radyolar</h2>
        <a href={paths.radioDirectory()} class="text-sm font-semibold text-ink underline decoration-primary-500 underline-offset-4">Tüm {stations.length} radyo (A–Z)</a>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
        {stations.filter((s) => s.coverageType === 'national').map((station) => <BrandCard brand={station} kind="radio" />)}
      </div>
    </section>
  </div>
</BaseLayout>
