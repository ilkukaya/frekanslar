---
/**
 * Terrestrial (DVB-T2) TV frequency overview built from the RTÜK licence
 * lists: one row per channel with its reach and its İstanbul/Ankara/İzmir
 * assignments, plus an index of every province.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ListenButton from '../../components/ListenButton.astro';
import AdSlot from '../../components/AdSlot.astro';
import FAQSection from '../../components/FAQSection.astro';
import { formatDateTr, formatTvChannel } from '../../lib/format';
import { canonicalUrl, paths } from '../../lib/urls';
import { breadcrumbListSchema, collectionPageSchema, faqPageSchema } from '../../lib/seo/jsonld';

const [channelEntries, assignmentEntries, cityEntries] = await Promise.all([
  getCollection('television-channels'),
  getCollection('terrestrial-tv-channels'),
  getCollection('cities'),
]);

const cities = cityEntries.map((e) => e.data).sort((a, b) => a.name.localeCompare(b.name, 'tr'));
const assignments = assignmentEntries.map((e) => e.data).filter((a) => a.status === 'active');
const KEY_CITIES = ['istanbul', 'ankara', 'izmir'] as const;

const rows = channelEntries
  .map((e) => e.data)
  .map((channel) => {
    const own = assignments.filter((a) => a.channelId === channel.id);
    const cityIds = new Set(own.map((a) => a.cityId));
    const keyValues = Object.fromEntries(
      KEY_CITIES.map((cityId) => {
        const nums = [...new Set(own.filter((a) => a.cityId === cityId).map((a) => a.channelNumber))].sort((a, b) => a - b);
        return [cityId, nums];
      }),
    ) as Record<(typeof KEY_CITIES)[number], number[]>;
    return { channel, cityCount: cityIds.size, total: own.length, keyValues };
  })
  .filter((r) => r.total > 0)
  .sort((a, b) => b.cityCount - a.cityCount || a.channel.name.localeCompare(b.channel.name, 'tr'));

const cityCounts = new Map<string, number>();
for (const a of assignments) cityCounts.set(a.cityId, (cityCounts.get(a.cityId) ?? 0) + 1);
const latestVerifiedAt = assignments.map((a) => a.lastVerifiedAt).sort().at(-1);

const pagePath = paths.tvFrequencies();
const pageTitle = `Karasal TV Frekansları ${new Date().getFullYear()}: Kanal Kanal UHF/VHF Listesi (DVB-T2)`;
const pageDescription = `Türkiye'deki ${rows.length} televizyon kanalının dijital karasal (DVB-T2) yayın kanalları: il sayısı, İstanbul, Ankara ve İzmir UHF/VHF kanal numaraları ve MHz değerleri. RTÜK lisans verisi.`;

const breadcrumbItems = [
  { name: 'Ana Sayfa', href: paths.home() },
  { name: 'Karasal TV Frekansları', href: pagePath },
];

const faqs = [
  {
    question: 'Karasal TV frekansları neden kanal numarasıyla gösteriliyor?',
    answer: 'Dijital karasal yayında (DVB-T2) her yayın, standart bir UHF veya VHF kanalına yerleştirilir. Televizyonlar kanal numarasını ya da karşılık gelen MHz değerini kabul eder; tablodaki MHz değerleri standart kanal planına göre hesaplanmış merkez frekanslardır.',
  },
  {
    question: 'Karasal kanalları televizyonda nasıl bulurum?',
    answer: "Televizyonunuzun kurulum menüsünde anten tipini 'Anten/Karasal (DVB-T2)' seçip otomatik arama yapmanız çoğu zaman yeterlidir. Otomatik arama bir kanalı bulamazsa, bu sayfadaki kanal numarasıyla manuel arama yapabilirsiniz.",
  },
  {
    question: 'Aynı kanal her ilde aynı frekansta mı yayın yapar?',
    answer: 'Hayır. Karasal yayın vericileri bölgeye göre farklı kanallar kullanır. Bir kanalın il il tüm kanal numaralarını, kanalın profil sayfasındaki karasal yayın tablosunda görebilirsiniz.',
  },
];

const jsonLd = [
  breadcrumbListSchema(breadcrumbItems.map((item) => ({ name: item.name, url: canonicalUrl(item.href) }))),
  collectionPageSchema({
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl(pagePath),
    items: rows.map((r) => ({ name: r.channel.name, url: canonicalUrl(paths.televisionChannel(r.channel.slug)) })),
    dateModified: latestVerifiedAt,
  }),
  faqPageSchema(faqs),
];

const fmt = (nums: number[]) => (nums.length === 0 ? '—' : nums.map((n) => formatTvChannel(n)).join(', '));
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} lastUpdated={latestVerifiedAt} jsonLd={jsonLd}>
  <div class="mx-auto max-w-(--container-content) px-4 py-6 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 text-3xl text-ink sm:text-4xl">Karasal TV Frekansları</h1>
    <p class="mt-2 max-w-3xl text-ink-muted">
      Antenle (DVB-T2) izlenebilen {rows.length} televizyon kanalının yayın kanalları. Tablo, kanalın kaç ilde
      karasal yayın tahsisi olduğuna göre sıralıdır; bir kanala tıklayarak il il tüm değerleri görün.
      {latestVerifiedAt && <> Kaynak: RTÜK, son kontrol {formatDateTr(latestVerifiedAt)}.</>}
    </p>

    <div class="mt-6 overflow-x-auto rounded-xl border border-border bg-surface" tabindex="0">
      <table class="responsive-table w-full border-collapse text-sm">
        <caption class="sr-only">Televizyon kanallarının karasal yayın kanal numaraları</caption>
        <thead class="bg-surface-subtle text-left">
          <tr>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Kanal</th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink">İl</th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink">İstanbul</th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Ankara</th>
            <th scope="col" class="px-3 py-2.5 font-semibold text-ink">İzmir</th>
            <th scope="col" class="px-3 py-2.5"><span class="sr-only">Canlı izle</span></th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(({ channel, cityCount, keyValues }) => (
              <tr>
                <td data-label="Kanal" class="border-t border-border px-3 py-2.5 font-semibold text-ink">
                  <a href={paths.televisionChannel(channel.slug)} class="hover:text-primary-600 hover:underline">{channel.name}</a>
                </td>
                <td data-label="İl" class="num border-t border-border px-3 py-2.5 text-ink">{cityCount}</td>
                <td data-label="İstanbul" class="num border-t border-border px-3 py-2.5 text-ink-muted">{fmt(keyValues.istanbul)}</td>
                <td data-label="Ankara" class="num border-t border-border px-3 py-2.5 text-ink-muted">{fmt(keyValues.ankara)}</td>
                <td data-label="İzmir" class="num border-t border-border px-3 py-2.5 text-ink-muted">{fmt(keyValues.izmir)}</td>
                <td class="border-t border-border px-3 py-2 text-right"><ListenButton brand={channel} kind="tv" /></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <AdSlot placement="inContent" />

    <section class="mt-10">
      <h2 class="text-2xl text-ink">İl İl Karasal TV Kanalları</h2>
      <p class="mt-1 text-sm text-ink-muted">Her il sayfasında o ildeki tüm karasal TV kanalları ve FM radyolar birlikte listelenir.</p>
      <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-6">
        {
          cities.map((c) => (
            <li>
              <a href={`${paths.city(c.slug)}#tv`} class="flex items-baseline justify-between rounded-lg border border-border bg-surface px-3 py-2 text-sm hover:border-ink">
                <span class="text-ink">{c.name}</span>
                <span class="num text-xs text-ink-faint">{cityCounts.get(c.id) ?? 0}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <FAQSection faqs={faqs} />
  </div>
</BaseLayout>
