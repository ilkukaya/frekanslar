---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import DataCard from '../../../components/DataCard.astro';
import VerificationBadge from '../../../components/VerificationBadge.astro';
import SourceList from '../../../components/SourceList.astro';
import LogoPlaceholder from '../../../components/LogoPlaceholder.astro';
import OfficialActionButton from '../../../components/OfficialActionButton.astro';
import FAQSection from '../../../components/FAQSection.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import BadgeSnippet from '../../../components/BadgeSnippet.astro';
import ClaimProfile from '../../../components/ClaimProfile.astro';
import { COVERAGE_TYPE_LABELS, BROADCAST_TYPE_LABELS, CHANGE_TYPE_LABELS } from '../../../lib/labels';
import { formatDateTr, formatFrequencyDisplay } from '../../../lib/format';
import { buildStationDirectAnswer } from '../../../lib/direct-answers';
import { generateStationFaqs } from '../../../lib/faq-generator';
import {
  byId,
  citiesForStation,
  frequenciesByStation,
  relatedBrands,
  servicesByStation,
  sourcesByIds,
  updatesForEntity,
} from '../../../lib/relations';
import { canonicalUrl, paths } from '../../../lib/urls';
import {
  breadcrumbListSchema,
  faqPageSchema,
  radioStationSchema as radioStationJsonLd,
  webPageSchema,
} from '../../../lib/seo/jsonld';

export const getStaticPaths = (async () => {
  const [
    stationEntries,
    cityEntries,
    transmitterEntries,
    frequencyEntries,
    broadcasterEntries,
    sourceEntries,
    updateEntries,
    serviceEntries,
    satelliteEntries,
    transponderEntries,
  ] = await Promise.all([
    getCollection('radio-stations'),
    getCollection('cities'),
    getCollection('transmitters'),
    getCollection('terrestrial-frequencies'),
    getCollection('broadcasters'),
    getCollection('sources'),
    getCollection('frequency-updates'),
    getCollection('satellite-services'),
    getCollection('satellites'),
    getCollection('transponders'),
  ]);

  const stations = stationEntries.map((e) => e.data);
  const cities = cityEntries.map((e) => e.data);
  const transmitters = transmitterEntries.map((e) => e.data);
  const frequencies = frequencyEntries.map((e) => e.data);
  const broadcasters = broadcasterEntries.map((e) => e.data);
  const sources = sourceEntries.map((e) => e.data);
  const updates = updateEntries.map((e) => e.data);
  const services = serviceEntries.map((e) => e.data).filter((s) => s.broadcastKind === 'radio');
  const satellites = satelliteEntries.map((e) => e.data);
  const transponders = transponderEntries.map((e) => e.data);

  return stations.map((station) => {
    const stationFrequencies = frequenciesByStation(frequencies, station.id).filter((f) => f.status === 'active');
    const activeCities = citiesForStation(cities, frequencies, station.id);
    const stationServices = servicesByStation(services, station.id).filter((s) => s.status === 'active');
    const broadcaster = station.owner ? (byId(broadcasters, station.owner) ?? null) : null;

    return {
      params: { radyo: station.slug },
      props: {
        station,
        stationFrequencies,
        activeCities,
        cities,
        transmitters,
        broadcaster,
        sources,
        updates: updatesForEntity(updates, station.id),
        stationServices,
        satellites,
        transponders,
        relatedStations: relatedBrands(stations, station, 4),
      },
    };
  });
}) satisfies GetStaticPaths;

const {
  station,
  stationFrequencies,
  activeCities,
  cities,
  transmitters,
  broadcaster,
  sources,
  updates,
  stationServices,
  satellites,
  transponders,
  relatedStations,
} = Astro.props;

const cityById = new Map(cities.map((c) => [c.id, c]));
const transmitterById = new Map(transmitters.map((t) => [t.id, t]));
const stationSources = sourcesByIds(sources, station.sourceIds);

const directAnswer = buildStationDirectAnswer(station, stationFrequencies, cities);
const faqs = generateStationFaqs(station, activeCities, broadcaster, stationServices.length > 0);

const pagePath = paths.radioStation(station.slug);
const pageTitle = `${station.name} Frekansları: Şehirlere Göre Güncel Liste`;
const pageDescription = `${station.name} frekans bilgileri: ${activeCities.length} şehirde FM frekansı, yayın kapsamı, resmî bağlantılar ve doğrulama durumu.`;

const breadcrumbItems = [
  { name: 'Ana Sayfa', href: paths.home() },
  { name: 'Radyo Frekansları', href: paths.radioList() },
  { name: station.name, href: pagePath },
];

const jsonLd = [
  webPageSchema({
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl(pagePath),
    dateModified: station.lastVerifiedAt,
  }),
  breadcrumbListSchema(breadcrumbItems.map((item) => ({ name: item.name, url: canonicalUrl(item.href) }))),
  radioStationJsonLd({
    name: station.name,
    description: station.description,
    url: canonicalUrl(pagePath),
    logo: station.logo,
    sameAs: Object.values(station.officialSocialLinks).filter((v): v is string => Boolean(v)),
    areaServed: 'Türkiye',
  }),
  ...(faqs.length > 0 ? [faqPageSchema(faqs)] : []),
];

const socialLinks = Object.entries(station.officialSocialLinks).filter(([, url]) => Boolean(url));
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} lastUpdated={station.lastVerifiedAt} jsonLd={jsonLd}>
  <div class="mx-auto max-w-(--container-content) px-4 py-6 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />

    <div class="mt-4 flex flex-wrap items-start gap-4">
      <LogoPlaceholder name={station.name} logo={station.logo} size="lg" />
      <div class="min-w-0 flex-1">
        <h1 class="text-2xl font-bold text-ink sm:text-3xl">{station.name}</h1>
        <p class="mt-1 text-sm text-ink-muted">
          {BROADCAST_TYPE_LABELS[station.broadcastType]} · {COVERAGE_TYPE_LABELS[station.coverageType]}
        </p>
        <div class="mt-2">
          <VerificationBadge status={station.verificationStatus} lastVerifiedAt={station.lastVerifiedAt} />
        </div>
      </div>
    </div>

    <div class="mt-6 rounded-lg border border-primary-100 bg-primary-50 p-4">
      <p class="text-sm font-semibold text-primary-700">{directAnswer.question}</p>
      <p class="mt-1 text-ink">{directAnswer.answer}</p>
    </div>

    <p class="mt-6 max-w-3xl text-ink-muted">{station.description}</p>

    <div class="mt-6 flex flex-wrap gap-3">
      <OfficialActionButton
        href={station.officialLiveUrl}
        label="Resmî Yayından Dinle"
        destinationDescription="Bu bağlantı sizi radyonun resmî canlı yayın sayfasına yönlendirir."
        analyticsEvent="official_listen_clicked"
        analyticsPayload={{ stationId: station.id }}
      />
      <OfficialActionButton
        href={station.officialWebsite}
        label="Resmî Web Sitesine Git"
        destinationDescription="Bu bağlantı sizi radyonun resmî web sitesine yönlendirir."
        variant="secondary"
        analyticsEvent="official_website_clicked"
        analyticsPayload={{ stationId: station.id }}
      />
    </div>

    <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-border bg-surface p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Merkezi</p>
        <p class="mt-1 font-medium text-ink">
          {station.headquarters ? (cityById.get(station.headquarters)?.name ?? station.headquarters) : 'Belirtilmemiş'}
        </p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Yayın Kuruluşu</p>
        <p class="mt-1 font-medium text-ink">{broadcaster ? broadcaster.name : 'Belirtilmemiş'}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Aktif Şehir Sayısı</p>
        <p class="mt-1 font-medium text-ink">{activeCities.length}</p>
      </div>
    </div>

    {
      socialLinks.length > 0 && (
        <div class="mt-6">
          <h2 class="text-sm font-semibold text-ink">Resmî Sosyal Medya Hesapları</h2>
          <div class="mt-2 flex flex-wrap gap-2">
            {socialLinks.map(([platform, url]) => (
              <a
                href={url as string}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md border border-border-strong px-3 py-1.5 text-sm capitalize text-ink hover:bg-surface-subtle"
              >
                {platform}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <section class="mt-10">
      <h2 class="text-xl font-bold text-ink">Şehir Bazlı FM Frekansları</h2>
      {
        stationFrequencies.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted">Bu radyo için henüz doğrulanmış bir FM frekans kaydı bulunmuyor.</p>
        ) : (
          <div class="mt-4 overflow-x-auto rounded-lg border border-border" tabindex="0">
            <table class="responsive-table w-full border-collapse text-sm">
              <caption class="sr-only">{station.name} için şehir bazlı FM frekansları</caption>
              <thead class="bg-surface-subtle text-left">
                <tr>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Şehir</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Frekans</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">İlçe / Verici</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Kapsam</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Son kontrol</th>
                </tr>
              </thead>
              <tbody>
                {stationFrequencies.map((freq) => {
                  const city = cityById.get(freq.cityId);
                  const transmitter = freq.transmitterId ? transmitterById.get(freq.transmitterId) : undefined;
                  return (
                    <tr>
                      <td data-label="Şehir" class="border-t border-border px-3 py-2.5 font-medium text-ink">
                        {city ? <a href={paths.city(city.slug)} class="text-primary-600 hover:underline">{city.name}</a> : freq.cityId}
                      </td>
                      <td data-label="Frekans" class="border-t border-border px-3 py-2.5">
                        <a href={paths.radioStationCity(station.slug, city?.slug ?? freq.cityId)} class="font-medium text-ink hover:text-primary-600 hover:underline">
                          {formatFrequencyDisplay(freq.frequency, freq.unit)}
                        </a>
                      </td>
                      <td data-label="İlçe / Verici" class="border-t border-border px-3 py-2.5 text-ink-muted">
                        {transmitter ? transmitter.name : '—'}
                      </td>
                      <td data-label="Kapsam" class="border-t border-border px-3 py-2.5 text-ink-muted">
                        {COVERAGE_TYPE_LABELS[freq.coverageType]}
                      </td>
                      <td data-label="Son kontrol" class="border-t border-border px-3 py-2.5 text-ink-faint">
                        <time datetime={freq.lastVerifiedAt}>{formatDateTr(freq.lastVerifiedAt)}</time>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    {
      stationServices.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-ink">Uydu Yayın Bilgileri</h2>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {stationServices.map((service) => {
              const transponder = transponders.find((t) => t.id === service.transponderId);
              const satellite = transponder ? satellites.find((s) => s.id === transponder.satelliteId) : undefined;
              return (
                <DataCard
                  label="Uydu"
                  value={satellite?.name ?? 'Bilinmiyor'}
                  context={transponder ? `${transponder.frequencyMhz} ${transponder.polarization} ${transponder.symbolRate}` : undefined}
                  lastVerifiedAt={service.lastVerifiedAt}
                  verificationStatus={service.verificationStatus}
                  sources={sourcesByIds(sources, service.sourceIds)}
                />
              );
            })}
          </div>
        </section>
      )
    }

    <section class="mt-10">
      <h2 class="text-xl font-bold text-ink">Veri Kaynakları ve Doğrulama</h2>
      <div class="mt-3 rounded-lg border border-border bg-surface p-4">
        <VerificationBadge status={station.verificationStatus} lastVerifiedAt={station.lastVerifiedAt} />
        <div class="mt-2">
          <SourceList sources={stationSources} />
        </div>
      </div>
    </section>

    {
      updates.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-ink">Eski Frekanslar ve Değişiklik Geçmişi</h2>
          <ul class="mt-4 divide-y divide-border rounded-lg border border-border bg-surface">
            {updates.map((update) => (
              <li>
                <a href={paths.update(update.slug)} class="flex flex-col gap-1 px-4 py-3 hover:bg-surface-subtle sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <p class="font-medium text-ink">{update.title}</p>
                    <p class="text-sm text-ink-muted">{CHANGE_TYPE_LABELS[update.changeType]}</p>
                  </div>
                  <time datetime={update.date} class="text-xs text-ink-faint">{formatDateTr(update.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <RelatedLinks
      title="İlgili Radyo İstasyonları"
      items={relatedStations.map((s) => ({ name: s.name, href: paths.radioStation(s.slug) }))}
    />

    <FAQSection faqs={faqs} />

    <ClaimProfile entityName={station.name} path={pagePath} />
    <BadgeSnippet path={pagePath} verified={station.verificationStatus === 'verified'} />

    <p class="mt-8 text-sm text-ink-muted">
      Hatalı bir bilgi mi gördünüz?{' '}
      <a href={`${paths.correction()}?ilgili=${encodeURIComponent(station.name)}`} class="font-medium text-primary-600 underline hover:no-underline">
        Düzeltme bildirin
      </a>.
    </p>
  </div>
</BaseLayout>
