---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import VerificationBadge from '../../../components/VerificationBadge.astro';
import SourceList from '../../../components/SourceList.astro';
import { BROADCAST_KIND_LABELS, CHANGE_TYPE_LABELS, ENCRYPTION_LABELS, RESOLUTION_LABELS } from '../../../lib/labels';
import { formatDateTr, formatSymbolRate, formatTransponderFrequency } from '../../../lib/format';
import { byId, servicesByTransponder, sourcesByIds } from '../../../lib/relations';
import { canonicalUrl, paths } from '../../../lib/urls';
import { breadcrumbListSchema, webPageSchema } from '../../../lib/seo/jsonld';

export const getStaticPaths = (async () => {
  const [transponderEntries, satelliteEntries, serviceEntries, radioEntries, tvEntries, sourceEntries, updateEntries] =
    await Promise.all([
      getCollection('transponders'),
      getCollection('satellites'),
      getCollection('satellite-services'),
      getCollection('radio-stations'),
      getCollection('television-channels'),
      getCollection('sources'),
      getCollection('frequency-updates'),
    ]);

  const transponders = transponderEntries.map((e) => e.data);
  const satellites = satelliteEntries.map((e) => e.data);
  const services = serviceEntries.map((e) => e.data);
  const radioStations = radioEntries.map((e) => e.data);
  const televisionChannels = tvEntries.map((e) => e.data);
  const sources = sourceEntries.map((e) => e.data);
  const updates = updateEntries.map((e) => e.data);

  return transponders.map((transponder) => {
    const transponderServices = servicesByTransponder(services, transponder.id);
    const serviceIds = new Set(transponderServices.map((s) => s.id));
    const relatedUpdates = updates
      .filter((u) => u.entityId && serviceIds.has(u.entityId))
      .sort((a, b) => b.date.localeCompare(a.date));

    return {
      params: { transponder: transponder.slug },
      props: {
        transponder,
        satellite: byId(satellites, transponder.satelliteId) ?? null,
        transponderServices,
        radioStations,
        televisionChannels,
        sources,
        relatedUpdates,
      },
    };
  });
}) satisfies GetStaticPaths;

const { transponder, satellite, transponderServices, radioStations, televisionChannels, sources, relatedUpdates } =
  Astro.props;

const transponderSources = sourcesByIds(sources, transponder.sourceIds);

const pagePath = paths.transponder(transponder.slug);
const pageTitle = `${transponder.frequencyMhz} ${transponder.polarization} ${transponder.symbolRate} Transponder Bilgileri${satellite ? ` — ${satellite.name}` : ''}`;
const pageDescription = `${satellite ? `${satellite.name} üzerindeki ` : ''}${transponder.frequencyMhz} MHz ${transponder.polarization} ${transponder.symbolRate} transponderinin polarizasyon, FEC, modülasyon ve taşıdığı kanal bilgileri.`;

const breadcrumbItems = [
  { name: 'Ana Sayfa', href: paths.home() },
  { name: 'Uydu Frekansları', href: paths.satelliteList() },
  ...(satellite ? [{ name: satellite.name, href: paths.satellite(satellite.slug) }] : []),
  { name: `${transponder.frequencyMhz} ${transponder.polarization} ${transponder.symbolRate}`, href: pagePath },
];

const jsonLd = [
  webPageSchema({ name: pageTitle, description: pageDescription, url: canonicalUrl(pagePath), dateModified: transponder.lastVerifiedAt }),
  breadcrumbListSchema(breadcrumbItems.map((item) => ({ name: item.name, url: canonicalUrl(item.href) }))),
];
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} lastUpdated={transponder.lastVerifiedAt} jsonLd={jsonLd}>
  <div class="mx-auto max-w-(--container-content) px-4 py-6 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 text-2xl font-bold text-ink sm:text-3xl">
      {transponder.frequencyMhz} {transponder.polarization} {transponder.symbolRate}
    </h1>
    {
      satellite && (
        <p class="mt-1 text-sm text-ink-muted">
          <a href={paths.satellite(satellite.slug)} class="text-primary-600 underline hover:no-underline">{satellite.name}</a>{' '}
          ({satellite.orbitalPosition}) üzerindeki bir transponder
        </p>
      )
    }
    <div class="mt-2">
      <VerificationBadge status={transponder.verificationStatus} lastVerifiedAt={transponder.lastVerifiedAt} />
    </div>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-5">
      <div class="rounded-lg border border-border bg-surface p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Frekans</p>
        <p class="mt-1 font-medium text-ink">{formatTransponderFrequency(transponder.frequencyMhz)}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Polarizasyon</p>
        <p class="mt-1 font-medium text-ink">{transponder.polarization}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Sembol Oranı</p>
        <p class="mt-1 font-medium text-ink">{formatSymbolRate(transponder.symbolRate)}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">FEC</p>
        <p class="mt-1 font-medium text-ink">{transponder.fec}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-ink-faint">Modülasyon</p>
        <p class="mt-1 font-medium text-ink">{transponder.modulation}</p>
      </div>
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-ink">Transponder Üzerindeki Servisler</h2>
      {
        transponderServices.length === 0 ? (
          <p class="mt-3 text-sm text-ink-muted">Bu transponder için henüz kayıtlı bir servis bulunmuyor.</p>
        ) : (
          <div class="mt-4 overflow-x-auto rounded-lg border border-border" tabindex="0">
            <table class="responsive-table w-full border-collapse text-sm">
              <caption class="sr-only">Transponder üzerindeki servisler</caption>
              <thead class="bg-surface-subtle text-left">
                <tr>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Kanal</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Tür</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Görüntü</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Şifreleme</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Servis ID</th>
                </tr>
              </thead>
              <tbody>
                {transponderServices.map((service) => {
                  const brand =
                    service.broadcastKind === 'tv'
                      ? byId(televisionChannels, service.stationId)
                      : byId(radioStations, service.stationId);
                  const href = brand
                    ? service.broadcastKind === 'tv'
                      ? paths.televisionChannel(brand.slug)
                      : paths.radioStation(brand.slug)
                    : null;
                  return (
                    <tr>
                      <td data-label="Kanal" class="border-t border-border px-3 py-2.5 font-medium text-ink">
                        {brand && href ? <a href={href} class="text-primary-600 hover:underline">{brand.name}</a> : service.stationId}
                      </td>
                      <td data-label="Tür" class="border-t border-border px-3 py-2.5 text-ink-muted">{BROADCAST_KIND_LABELS[service.broadcastKind]}</td>
                      <td data-label="Görüntü" class="border-t border-border px-3 py-2.5 text-ink-muted">{service.resolution ? RESOLUTION_LABELS[service.resolution] : '—'}</td>
                      <td data-label="Şifreleme" class="border-t border-border px-3 py-2.5 text-ink-muted">{ENCRYPTION_LABELS[service.encryption]}</td>
                      <td data-label="Servis ID" class="border-t border-border px-3 py-2.5 font-mono text-ink-muted">{service.serviceIdNumber ?? '—'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    {
      relatedUpdates.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-ink">Eski Değişiklik Geçmişi</h2>
          <ul class="mt-4 divide-y divide-border rounded-lg border border-border bg-surface">
            {relatedUpdates.map((update) => (
              <li>
                <a href={paths.update(update.slug)} class="flex flex-col gap-1 px-4 py-3 hover:bg-surface-subtle sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <p class="font-medium text-ink">{update.title}</p>
                    <p class="text-sm text-ink-muted">{CHANGE_TYPE_LABELS[update.changeType]}</p>
                  </div>
                  <time datetime={update.date} class="text-xs text-ink-faint">{formatDateTr(update.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-10">
      <h2 class="text-xl font-bold text-ink">Veri Kaynakları ve Doğrulama</h2>
      <div class="mt-3 rounded-lg border border-border bg-surface p-4">
        <VerificationBadge status={transponder.verificationStatus} lastVerifiedAt={transponder.lastVerifiedAt} />
        <div class="mt-2">
          <SourceList sources={transponderSources} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
