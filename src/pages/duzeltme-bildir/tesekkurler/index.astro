---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { paths } from '../../../lib/urls';

const pagePath = paths.correctionThanks();
const pageTitle = 'Teşekkürler | Frekanslar';
const pageDescription = 'Düzeltme bildiriminiz alındı.';
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} robots="noindex,follow">
  <article class="mx-auto max-w-(--container-narrow) px-4 py-16 text-center sm:px-6">
    <h1 class="text-2xl font-bold text-ink sm:text-3xl">Teşekkürler!</h1>
    <p class="mt-3 text-ink-muted">
      Düzeltme bildiriminiz alındı. Editöryal ekibimiz talebinizi inceleyecektir. İlgili kayıt güncellendiğinde
      profil sayfasındaki son doğrulama tarihi yenilenecektir.
    </p>
    <a
      href={paths.home()}
      class="mt-6 inline-flex items-center rounded-md bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700"
    >
      Ana sayfaya dön
    </a>
  </article>
</BaseLayout>
