---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BrandCard from '../../components/BrandCard.astro';
import { sortByName } from '../../lib/relations';
import { canonicalUrl, paths } from '../../lib/urls';
import { breadcrumbListSchema, collectionPageSchema } from '../../lib/seo/jsonld';

const channelEntries = await getCollection('television-channels');
const channels = sortByName(channelEntries.map((e) => e.data));

const pagePath = paths.tvList();
const pageTitle = 'Türkiye Televizyon Kanalları: Güncel Kanal Listesi';
const pageDescription = `Türkiye'de yayın yapan ${channels.length} televizyon kanalının profiline, uydu frekansı ve platform bilgilerine ulaşın.`;

const breadcrumbItems = [
  { name: 'Ana Sayfa', href: paths.home() },
  { name: 'Televizyon Kanalları', href: pagePath },
];

const jsonLd = [
  breadcrumbListSchema(breadcrumbItems.map((item) => ({ name: item.name, url: canonicalUrl(item.href) }))),
  collectionPageSchema({
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl(pagePath),
    items: channels.map((channel) => ({ name: channel.name, url: canonicalUrl(paths.televisionChannel(channel.slug)) })),
  }),
];
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} jsonLd={jsonLd}>
  <div class="mx-auto max-w-(--container-content) px-4 py-6 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 text-2xl font-bold text-ink sm:text-3xl">Türkiye Televizyon Kanalları</h1>
    <p class="mt-2 max-w-2xl text-ink-muted">
      {channels.length} televizyon kanalının profiline, güncel uydu frekansına ve platform kanal numaralarına
      buradan ulaşabilirsiniz. Frekans bilgilerine göre karşılaştırmak isterseniz
      <a href={paths.tvFrequencies()} class="text-primary-600 underline hover:no-underline">TV frekansları tablosuna</a> bakın.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {channels.map((channel) => <BrandCard brand={channel} kind="tv" />)}
    </div>
  </div>
</BaseLayout>
