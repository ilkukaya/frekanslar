---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import VerificationBadge from '../../../components/VerificationBadge.astro';
import SourceList from '../../../components/SourceList.astro';
import ProfileHero from '../../../components/ProfileHero.astro';
import Kunye from '../../../components/Kunye.astro';
import AdSlot from '../../../components/AdSlot.astro';
import FAQSection from '../../../components/FAQSection.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import BadgeSnippet from '../../../components/BadgeSnippet.astro';
import ClaimProfile from '../../../components/ClaimProfile.astro';
import {
  CHANGE_TYPE_LABELS,
  ENCRYPTION_LABELS,
  RESOLUTION_LABELS,
} from '../../../lib/labels';
import { formatDateTr, formatSymbolRate, formatTransponderFrequency, formatTvChannel } from '../../../lib/format';
import { buildChannelDirectAnswer } from '../../../lib/direct-answers';
import { generateChannelFaqs } from '../../../lib/faq-generator';
import {
  byId,
  platformChannelsByChannel,
  relatedBrands,
  servicesByStation,
  sourcesByIds,
  updatesForEntity,
} from '../../../lib/relations';
import { canonicalUrl, paths } from '../../../lib/urls';
import {
  breadcrumbListSchema,
  faqPageSchema,
  televisionStationSchema as tvStationJsonLd,
  webPageSchema,
} from '../../../lib/seo/jsonld';

export const getStaticPaths = (async () => {
  const [
    channelEntries,
    broadcasterEntries,
    sourceEntries,
    updateEntries,
    serviceEntries,
    satelliteEntries,
    transponderEntries,
    platformChannelEntries,
    platformEntries,
  ] = await Promise.all([
    getCollection('television-channels'),
    getCollection('broadcasters'),
    getCollection('sources'),
    getCollection('frequency-updates'),
    getCollection('satellite-services'),
    getCollection('satellites'),
    getCollection('transponders'),
    getCollection('platform-channels'),
    getCollection('platforms'),
  ]);
  const [radioEntries, cityEntries, tvAssignmentEntries, districtEntries] = await Promise.all([
    getCollection('radio-stations'),
    getCollection('cities'),
    getCollection('terrestrial-tv-channels'),
    getCollection('districts'),
  ]);
  const ownerBrandCounts = new Map<string, number>();
  for (const brand of [...channelEntries, ...radioEntries]) {
    const owner = brand.data.owner;
    if (owner) ownerBrandCounts.set(owner, (ownerBrandCounts.get(owner) ?? 0) + 1);
  }
  const cities = cityEntries.map((e) => e.data);
  const cityById = new Map(cities.map((c) => [c.id, c]));
  const districtById = new Map(districtEntries.map((e) => [e.data.id, e.data]));
  const assignmentsByChannel = new Map<string, (typeof tvAssignmentEntries)[number]['data'][]>();
  for (const { data } of tvAssignmentEntries) {
    if (data.status !== 'active') continue;
    const list = assignmentsByChannel.get(data.channelId) ?? [];
    list.push(data);
    assignmentsByChannel.set(data.channelId, list);
  }

  const channels = channelEntries.map((e) => e.data);
  const broadcasters = broadcasterEntries.map((e) => e.data);
  const sources = sourceEntries.map((e) => e.data);
  const updates = updateEntries.map((e) => e.data);
  const services = serviceEntries.map((e) => e.data).filter((s) => s.broadcastKind === 'tv');
  const satellites = satelliteEntries.map((e) => e.data);
  const transponders = transponderEntries.map((e) => e.data);
  const platformChannels = platformChannelEntries.map((e) => e.data);
  const platforms = platformEntries.map((e) => e.data);

  return channels.map((channel) => {
    const channelServices = servicesByStation(services, channel.id).filter((s) => s.status === 'active');
    const broadcaster = channel.owner ? (byId(broadcasters, channel.owner) ?? null) : null;
    const channelPlatforms = platformChannelsByChannel(platformChannels, channel.id);

    return {
      params: { kanal: channel.slug },
      props: {
        channel,
        channelServices,
        broadcaster,
        sources,
        updates: updatesForEntity(updates, channel.id),
        satellites,
        transponders,
        channelPlatforms,
        platforms,
        relatedChannels: relatedBrands(channels, channel, 4),
        otherBrandCount: channel.owner ? (ownerBrandCounts.get(channel.owner) ?? 1) - 1 : 0,
        hqCity: channel.headquarters ? (cityById.get(channel.headquarters) ?? null) : null,
        terrestrialRows: (assignmentsByChannel.get(channel.id) ?? [])
          .map((a) => ({
            assignment: a,
            city: cityById.get(a.cityId) ?? null,
            district: a.districtId ? (districtById.get(a.districtId) ?? null) : null,
          }))
          .sort(
            (x, y) =>
              (x.city?.name ?? '').localeCompare(y.city?.name ?? '', 'tr') ||
              (x.district?.name ?? '').localeCompare(y.district?.name ?? '', 'tr'),
          ),
      },
    };
  });
}) satisfies GetStaticPaths;

const {
  channel,
  channelServices,
  broadcaster,
  sources,
  updates,
  satellites,
  transponders,
  channelPlatforms,
  platforms,
  relatedChannels,
  otherBrandCount,
  hqCity,
  terrestrialRows,
} = Astro.props;

const terrestrialCities = [...new Map(terrestrialRows.filter((r) => r.city).map((r) => [r.city!.id, r.city!])).values()];

const channelSources = sourcesByIds(sources, channel.sourceIds);
const platformById = new Map(platforms.map((p) => [p.id, p]));

const satelliteAnswer = buildChannelDirectAnswer(channel, channelServices, transponders, satellites);
const istanbulRow = terrestrialRows.find((r) => r.city?.id === 'istanbul') ?? terrestrialRows[0];
const directAnswer =
  channelServices.length === 0 && istanbulRow
    ? {
        question: `${channel.name} karasal yayın frekansı nedir?`,
        answer: `RTÜK lisans kayıtlarına göre ${channel.name}, ${terrestrialCities.length} ilde dijital karasal (DVB-T2) yayın tahsisine sahip. Örneğin ${istanbulRow.city?.name ?? ''}${istanbulRow.district ? ` (${istanbulRow.district.name})` : ''} için ${istanbulRow.assignment.band} bandında ${formatTvChannel(istanbulRow.assignment.channelNumber)} olarak kayıtlı. Tüm iller aşağıdaki tabloda.`,
      }
    : satelliteAnswer;
const faqs = generateChannelFaqs(
  channel,
  channelServices.length > 0,
  channelPlatforms.length,
  broadcaster,
  terrestrialCities.map((c) => c.name),
);

const pagePath = paths.televisionChannel(channel.slug);
const pageTitle =
  terrestrialCities.length > 0
    ? `${channel.name} Frekansı: Karasal Yayın Kanalları, Canlı İzle, Künye`
    : `${channel.name} Frekansı, Canlı İzle ve Kanal Künyesi`;
const pageDescription =
  terrestrialCities.length > 0
    ? `${channel.name} ${terrestrialCities.length} ilde dijital karasal (DVB-T2) yayında. İl il UHF/VHF kanal numaraları ve MHz değerleri, resmî canlı yayın bağlantısı ve kanal künyesi.`
    : `${channel.name} yayın bilgileri, resmî canlı yayın bağlantısı, lisans sahibi kuruluş ve kanal künyesi.`;
const reachSummary =
  terrestrialCities.length > 0
    ? `${terrestrialCities.length} ilde ${terrestrialRows.length} karasal yayın tahsisi${broadcaster ? ` · ${broadcaster.name}` : ''}`
    : (broadcaster?.name ?? 'Televizyon kanalı');

const breadcrumbItems = [
  { name: 'Ana Sayfa', href: paths.home() },
  { name: 'Televizyon Kanalları', href: paths.tvList() },
  { name: channel.name, href: pagePath },
];

const jsonLd = [
  webPageSchema({
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl(pagePath),
    dateModified: channel.lastVerifiedAt,
  }),
  breadcrumbListSchema(breadcrumbItems.map((item) => ({ name: item.name, url: canonicalUrl(item.href) }))),
  tvStationJsonLd({
    name: channel.name,
    description: channel.description,
    url: canonicalUrl(pagePath),
    logo: channel.logo,
    sameAs: [channel.officialWebsite, ...Object.values(channel.officialSocialLinks)].filter((v): v is string => Boolean(v)),
    areaServed: 'Türkiye',
  }),
  ...(faqs.length > 0 ? [faqPageSchema(faqs)] : []),
];

---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath} lastUpdated={channel.lastVerifiedAt} jsonLd={jsonLd}>
  <div class="mx-auto max-w-(--container-content) px-4 py-6 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />

    <ProfileHero brand={channel} kind="tv" hqName={hqCity?.name ?? null} reachSummary={reachSummary} />

    <div class="mt-6 rounded-xl border-l-4 border-primary-500 bg-surface p-5">
      <p class="font-display text-sm font-bold text-ink">{directAnswer.question}</p>
      <p class="mt-1.5 text-ink">{directAnswer.answer}</p>
    </div>

    <p class="mt-6 max-w-3xl leading-relaxed text-ink-muted">{channel.description}</p>

    <AdSlot placement="inContent" />

    <Kunye
      brand={channel}
      kind="tv"
      broadcaster={broadcaster}
      otherBrandCount={otherBrandCount}
      hq={hqCity ? { name: hqCity.name, slug: hqCity.slug } : null}
      cityCount={terrestrialCities.length}
      assignmentLabel="Karasal yayın tahsisi"
      assignmentCount={terrestrialRows.length}
      sources={channelSources}
    />

    {
      terrestrialRows.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl text-ink">{channel.name} Karasal Yayın Kanalları (DVB-T2)</h2>
          <p class="mt-1 max-w-3xl text-sm text-ink-muted">
            RTÜK lisans listelerindeki bant ve kanal numaraları. MHz değeri, standart UHF/VHF kanal planına göre
            hesaplanmış merkez frekanstır; televizyonunuzda otomatik arama yapmanız genellikle yeterlidir.
          </p>
          <div class="mt-4 overflow-x-auto rounded-xl border border-border bg-surface" tabindex="0">
            <table class="responsive-table w-full border-collapse text-sm">
              <caption class="sr-only">{channel.name} il bazında karasal yayın kanalları</caption>
              <thead class="bg-surface-subtle text-left">
                <tr>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">İl</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">İlçe / Verici</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Bant</th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">Kanal · Frekans</th>
                </tr>
              </thead>
              <tbody>
                {terrestrialRows.map(({ assignment, city, district }) => (
                  <tr>
                    <td data-label="İl" class="border-t border-border px-3 py-2.5 font-medium text-ink">
                      {city ? <a href={paths.city(city.slug)} class="hover:text-primary-600 hover:underline">{city.name}</a> : assignment.cityId}
                    </td>
                    <td data-label="İlçe / Verici" class="border-t border-border px-3 py-2.5 text-ink-muted">{district?.name ?? '—'}</td>
                    <td data-label="Bant" class="border-t border-border px-3 py-2.5 text-ink-muted">{assignment.band}</td>
                    <td data-label="Kanal · Frekans" class="num border-t border-border px-3 py-2.5 font-semibold text-ink">
                      {formatTvChannel(assignment.channelNumber)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section class="mt-10" hidden={channelServices.length === 0}>
      <h2 class="text-xl font-bold text-ink">Uydu Yayın Bilgileri</h2>
      {
        channelServices.length === 0 ? null : (
          channelServices.map((service) => {
            const transponder = transponders.find((t) => t.id === service.transponderId);
            const satellite = transponder ? satellites.find((s) => s.id === transponder.satelliteId) : undefined;
            const serviceSources = sourcesByIds(sources, service.sourceIds);
            return (
              <div class="mt-4 rounded-lg border border-border bg-surface p-5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="font-semibold text-ink">
                    {satellite ? (
                      <a href={paths.satellite(satellite.slug)} class="hover:text-primary-600 hover:underline">
                        {satellite.name}
                      </a>
                    ) : (
                      'Bilinmeyen uydu'
                    )}
                  </h3>
                  <VerificationBadge status={service.verificationStatus} compact />
                </div>
                {transponder && (
                  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                    <div>
                      <p class="text-xs text-ink-faint">Frekans</p>
                      <p class="font-medium text-ink">
                        <a href={paths.transponder(transponder.slug)} class="hover:text-primary-600 hover:underline">
                          {formatTransponderFrequency(transponder.frequencyMhz)}
                        </a>
                      </p>
                    </div>
                    <div>
                      <p class="text-xs text-ink-faint">Polarizasyon</p>
                      <p class="font-medium text-ink">{transponder.polarization}</p>
                    </div>
                    <div>
                      <p class="text-xs text-ink-faint">Sembol Oranı</p>
                      <p class="font-medium text-ink">{formatSymbolRate(transponder.symbolRate)}</p>
                    </div>
                    <div>
                      <p class="text-xs text-ink-faint">FEC</p>
                      <p class="font-medium text-ink">{transponder.fec}</p>
                    </div>
                    <div>
                      <p class="text-xs text-ink-faint">Modülasyon</p>
                      <p class="font-medium text-ink">{transponder.modulation}</p>
                    </div>
                    <div>
                      <p class="text-xs text-ink-faint">Görüntü Kalitesi</p>
                      <p class="font-medium text-ink">{service.resolution ? RESOLUTION_LABELS[service.resolution] : '—'}</p>
                    </div>
                    <div>
                      <p class="text-xs text-ink-faint">Yayın Şifreleme</p>
                      <p class="font-medium text-ink">{ENCRYPTION_LABELS[service.encryption]}</p>
                    </div>
                    <div>
                      <p class="text-xs text-ink-faint">Kapsama</p>
                      <p class="font-medium text-ink">{service.coverage ?? '—'}</p>
                    </div>
                  </div>
                )}
                <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                  <div>
                    <p class="text-xs text-ink-faint">Video PID</p>
                    <p class="font-mono text-sm text-ink">{service.videoPid ?? '—'}</p>
                  </div>
                  <div>
                    <p class="text-xs text-ink-faint">Ses PID</p>
                    <p class="font-mono text-sm text-ink">{service.audioPids.length > 0 ? service.audioPids.join(', ') : '—'}</p>
                  </div>
                  <div>
                    <p class="text-xs text-ink-faint">PCR PID</p>
                    <p class="font-mono text-sm text-ink">{service.pcrPid ?? '—'}</p>
                  </div>
                  <div>
                    <p class="text-xs text-ink-faint">Servis / Ağ ID</p>
                    <p class="font-mono text-sm text-ink">{service.serviceIdNumber ?? '—'} / {service.networkId ?? '—'}</p>
                  </div>
                </div>
                <div class="mt-4 border-t border-border pt-3">
                  <VerificationBadge status={service.verificationStatus} lastVerifiedAt={service.lastVerifiedAt} />
                  <div class="mt-2">
                    <SourceList sources={serviceSources} />
                  </div>
                </div>
              </div>
            );
          })
        )
      }
      {
        channelServices.length > 0 && (
          <p class="mt-3 text-sm text-ink-muted">
            Bu kanalı alıcınıza eklemek için yukarıdaki frekans, polarizasyon, sembol oranı ve FEC bilgilerini
            kullanabilirsiniz. Ayrıntılı adımlar için{' '}
            <a href={paths.guide('uydu-kanali-nasil-eklenir')} class="text-primary-600 underline hover:no-underline">
              uydu kanalı ekleme rehberine
            </a>{' '}
            bakın.
          </p>
        )
      }
    </section>

    {
      channelPlatforms.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-ink">Platform Kanal Numaraları</h2>
          <div class="mt-4 overflow-x-auto rounded-lg border border-border" tabindex="0">
            <table class="responsive-table w-full border-collapse text-sm">
              <caption class="sr-only">{channel.name} platform kanal numaraları</caption>
              <thead class="bg-surface-subtle text-left">
                <tr>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">
                    Platform
                  </th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">
                    Kanal No
                  </th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">
                    Paket
                  </th>
                  <th scope="col" class="px-3 py-2.5 font-semibold text-ink">
                    Son kontrol
                  </th>
                </tr>
              </thead>
              <tbody>
                {channelPlatforms.map((entry) => {
                  const platform = platformById.get(entry.platformId);
                  return (
                    <tr>
                      <td data-label="Platform" class="border-t border-border px-3 py-2.5 font-medium text-ink">
                        {platform ? (
                          <a href={paths.platform(platform.slug)} class="text-primary-600 hover:underline">
                            {platform.name}
                          </a>
                        ) : (
                          entry.platformId
                        )}
                      </td>
                      <td data-label="Kanal No" class="border-t border-border px-3 py-2.5 text-ink">{entry.channelNumber}</td>
                      <td data-label="Paket" class="border-t border-border px-3 py-2.5 text-ink-muted">{entry.packageName ?? '—'}</td>
                      <td data-label="Son kontrol" class="border-t border-border px-3 py-2.5 text-ink-faint">
                        <time datetime={entry.lastVerifiedAt}>{formatDateTr(entry.lastVerifiedAt)}</time>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section class="mt-10">
      <h2 class="text-xl font-bold text-ink">Veri Kaynakları ve Doğrulama</h2>
      <div class="mt-3 rounded-lg border border-border bg-surface p-4">
        <VerificationBadge status={channel.verificationStatus} lastVerifiedAt={channel.lastVerifiedAt} />
        <div class="mt-2">
          <SourceList sources={channelSources} />
        </div>
      </div>
    </section>

    {
      updates.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-ink">Eski Frekans Geçmişi</h2>
          <ul class="mt-4 divide-y divide-border rounded-lg border border-border bg-surface">
            {updates.map((update) => (
              <li>
                <a href={paths.update(update.slug)} class="flex flex-col gap-1 px-4 py-3 hover:bg-surface-subtle sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <p class="font-medium text-ink">{update.title}</p>
                    <p class="text-sm text-ink-muted">{CHANGE_TYPE_LABELS[update.changeType]}</p>
                  </div>
                  <time datetime={update.date} class="text-xs text-ink-faint">{formatDateTr(update.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <RelatedLinks
      title="İlgili Kanallar"
      items={relatedChannels.map((c) => ({ name: c.name, href: paths.televisionChannel(c.slug) }))}
    />

    <FAQSection faqs={faqs} />

    <ClaimProfile entityName={channel.name} path={pagePath} />
    <BadgeSnippet path={pagePath} verified={channel.verificationStatus === 'verified'} />

    <p class="mt-8 text-sm text-ink-muted">
      Hatalı bir bilgi mi gördünüz?{' '}
      <a href={`${paths.correction()}?ilgili=${encodeURIComponent(channel.name)}`} class="font-medium text-primary-600 underline hover:no-underline">
        Düzeltme bildirin
      </a>.
    </p>
  </div>
</BaseLayout>
