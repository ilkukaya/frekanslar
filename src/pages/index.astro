---
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import BrandCard from '../components/BrandCard.astro';
import GuideCard from '../components/GuideCard.astro';
import FrequencyDial from '../components/FrequencyDial.astro';
import FAQSection from '../components/FAQSection.astro';
import AdSlot from '../components/AdSlot.astro';
import { siteConfig } from '../config/site';
import { paths, canonicalUrl } from '../lib/urls';
import { faqPageSchema, organizationSchema, websiteSchema, datasetSchema } from '../lib/seo/jsonld';

const [cityEntries, radioEntries, tvEntries, guideEntries, frequencyEntries, tvAssignEntries, broadcasterEntries] =
  await Promise.all([
    getCollection('cities'),
    getCollection('radio-stations'),
    getCollection('television-channels'),
    getCollection('guides'),
    getCollection('terrestrial-frequencies'),
    getCollection('terrestrial-tv-channels'),
    getCollection('broadcasters'),
  ]);

const cities = cityEntries.map((e) => e.data).sort((a, b) => a.name.localeCompare(b.name, 'tr'));
const radios = radioEntries.map((e) => e.data);
const tvs = tvEntries.map((e) => e.data);
const frequencies = frequencyEntries.map((e) => e.data).filter((f) => f.status === 'active');
const tvAssignments = tvAssignEntries.map((e) => e.data).filter((a) => a.status === 'active');
const radioById = new Map(radios.map((r) => [r.id, r]));

const freqCount = new Map<string, number>();
for (const f of frequencies) freqCount.set(f.stationId, (freqCount.get(f.stationId) ?? 0) + 1);
const tvCityCount = new Map<string, Set<string>>();
for (const a of tvAssignments) tvCityCount.set(a.channelId, (tvCityCount.get(a.channelId) ?? new Set()).add(a.cityId));

const hasLink = (b: { officialLiveUrl: string | null; officialWebsite: string | null }) =>
  Boolean(b.officialLiveUrl ?? b.officialWebsite);

const nationalRadios = radios
  .filter((r) => r.coverageType === 'national')
  .sort((a, b) => Number(hasLink(b)) - Number(hasLink(a)) || (freqCount.get(b.id) ?? 0) - (freqCount.get(a.id) ?? 0))
  .slice(0, 12);

const nationalTvs = tvs
  .filter((t) => t.coverageType === 'national')
  .sort((a, b) => Number(hasLink(b)) - Number(hasLink(a)) || (tvCityCount.get(b.id)?.size ?? 0) - (tvCityCount.get(a.id)?.size ?? 0))
  .slice(0, 12);

// Istanbul dial: every active FM frequency; national/regional brands get a label.
const dialStations = frequencies
  .filter((f) => f.cityId === 'istanbul')
  .map((f) => {
    const station = radioById.get(f.stationId);
    return station
      ? { frequency: f.frequency, name: station.name, slug: station.slug, prominent: station.coverageType === 'national' }
      : null;
  })
  .filter((s): s is NonNullable<typeof s> => s !== null)
  .sort((a, b) => a.frequency - b.frequency);

const popularCitySlugs = ['istanbul', 'ankara', 'izmir', 'bursa', 'antalya', 'adana', 'konya', 'gaziantep', 'kocaeli', 'mersin', 'kayseri', 'samsun'];
const popularCities = popularCitySlugs
  .map((slug) => cities.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const guides = guideEntries
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.updatedDate.localeCompare(a.data.updatedDate))
  .slice(0, 6);

const stats = [
  { value: radios.length.toLocaleString('tr-TR'), label: 'radyo' },
  { value: tvs.length.toLocaleString('tr-TR'), label: 'televizyon' },
  { value: frequencies.length.toLocaleString('tr-TR'), label: 'FM frekansı' },
  { value: tvAssignments.length.toLocaleString('tr-TR'), label: 'karasal TV kanalı' },
  { value: String(cities.length), label: 'il' },
  { value: broadcasterEntries.length.toLocaleString('tr-TR'), label: 'yayın kuruluşu' },
];

const faqs = [
  {
    question: 'Bulunduğum şehirde radyo frekanslarını nasıl öğrenebilirim?',
    answer: `Şehir listesinden ilinizi seçin; o ildeki tüm lisanslı FM radyoların frekanslarını, ilçe ve verici bazında tek tabloda görürsünüz. ${cities.length} ilin tamamı RTÜK lisans verisiyle listelenir.`,
  },
  {
    question: 'Bir radyonun frekansı her şehirde aynı mı?',
    answer: 'Hayır. Ulusal radyolar bile her ilde farklı bir FM frekansı kullanabilir. Bu yüzden radyo profillerinde frekanslar il il ayrı gösterilir.',
  },
  {
    question: 'Frekanslar sitesinde radyo dinleyebilir miyim?',
    answer: 'Frekanslar bir rehberdir; sitede yayın akışı barındırılmaz. Her radyo ve kanal sayfasındaki "Dinle" veya "İzle" butonu sizi yayıncının kendi resmî canlı yayın sayfasına yönlendirir.',
  },
  {
    question: 'Karasal (antenle) TV kanallarının frekansı nedir?',
    answer: 'Dijital karasal yayında (DVB-T2) kanallar UHF/VHF kanal numarasıyla yayınlanır. Her TV kanalının sayfasında il il bant, kanal numarası ve karşılık gelen MHz değeri yer alır.',
  },
  {
    question: 'Veriler nereden geliyor?',
    answer: "Karasal radyo ve televizyon frekans/lisans bilgileri Radyo ve Televizyon Üst Kurulu'nun (RTÜK) resmî il bazlı yayın lisans listelerinden alınır ve her kayıtta kaynağı ile son kontrol tarihi gösterilir.",
  },
];

const jsonLd = [
  organizationSchema(),
  websiteSchema(),
  datasetSchema({
    name: 'Türkiye Karasal Radyo ve Televizyon Frekans Veritabanı',
    description: `RTÜK lisans listelerinden derlenen ${frequencies.length} FM frekansı ve ${tvAssignments.length} karasal TV kanal tahsisi (${cities.length} il).`,
    url: canonicalUrl(paths.dataSources()),
    dateModified: frequencies.map((f) => f.lastVerifiedAt).sort().at(-1) ?? '2026-08-05',
    keywords: ['radyo frekansları', 'FM frekans', 'karasal TV', 'DVB-T2', 'RTÜK'],
  }),
  faqPageSchema(faqs),
];
---

<BaseLayout title={siteConfig.defaultTitle} description={siteConfig.defaultDescription} path={paths.home()} jsonLd={jsonLd}>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto grid max-w-(--container-content) gap-10 px-4 pb-10 pt-10 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:pb-14 lg:pt-14">
      <div>
        <p class="text-sm font-semibold text-primary-600">Türkiye radyo ve TV frekans rehberi</p>
        <h1 class="mt-3 text-[2.4rem] leading-[1.02] text-ink sm:text-6xl">
          Hangi radyo<br class="hidden sm:block" /> hangi frekansta?
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-muted">
          Türkiye'deki {radios.length.toLocaleString('tr-TR')} radyo ve {tvs.length} televizyonun il il frekansları,
          künyeleri ve resmî canlı yayın bağlantıları. Tek yerde, kaynağıyla.
        </p>
        <div class="mt-7 max-w-xl">
          <SearchBox size="large" />
        </div>
        <form class="mt-4 flex max-w-xl items-center gap-2" action={paths.radioList()} data-city-picker>
          <label for="city-picker" class="shrink-0 text-sm font-medium text-ink-muted">Şehrinizi seçin:</label>
          <select id="city-picker" name="il" class="h-11 min-w-0 flex-1 rounded-full border border-border-strong bg-surface px-4 text-ink">
            <option value="">81 il…</option>
            {cities.map((c) => <option value={c.slug}>{c.name}</option>)}
          </select>
          <button type="submit" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ink text-surface hover:bg-primary-600" aria-label="Şehrin frekanslarına git">
            <ArrowRight class="h-5 w-5" aria-hidden="true" />
          </button>
        </form>
      </div>
      <div class="min-w-0">
        <FrequencyDial cityName="İstanbul" citySlug="istanbul" stations={dialStations} />
        <ul class="mt-4 grid grid-cols-3 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-6 lg:grid-cols-3">
          {
            stats.map((s) => (
              <li class="bg-surface px-3 py-3">
                <p class="num text-xl font-extrabold text-ink">{s.value}</p>
                <p class="text-xs text-ink-faint">{s.label}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-(--container-content) px-4 pt-12 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl text-ink sm:text-3xl">Ulusal radyolar</h2>
        <p class="mt-1 text-sm text-ink-muted">Türkiye genelinde yayın yapan radyolar. "Dinle" resmî yayına götürür.</p>
      </div>
      <a href={paths.radioDirectory()} class="shrink-0 text-sm font-semibold text-ink underline decoration-primary-500 underline-offset-4">Tüm radyolar</a>
    </div>
    <div class="mt-5 grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
      {nationalRadios.map((r) => <BrandCard brand={r} kind="radio" meta={`${freqCount.get(r.id) ?? 0} FM frekansı`} />)}
    </div>
  </section>

  <section class="mx-auto max-w-(--container-content) px-4 pt-12 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl text-ink sm:text-3xl">Ulusal TV kanalları</h2>
        <p class="mt-1 text-sm text-ink-muted">Karasal yayın kanalları ve resmî canlı yayın bağlantıları.</p>
      </div>
      <a href={paths.tvList()} class="shrink-0 text-sm font-semibold text-ink underline decoration-primary-500 underline-offset-4">Tüm kanallar</a>
    </div>
    <div class="mt-5 grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
      {nationalTvs.map((t) => <BrandCard brand={t} kind="tv" meta={tvCityCount.get(t.id)?.size ? `${tvCityCount.get(t.id)?.size} ilde karasal yayın` : 'Ulusal kanal'} />)}
    </div>
  </section>

  <div class="mx-auto max-w-(--container-content) px-4 sm:px-6"><AdSlot placement="inContent" /></div>

  <section class="mx-auto max-w-(--container-content) px-4 pt-12 sm:px-6">
    <h2 class="text-2xl text-ink sm:text-3xl">Şehre göre radyo frekansları</h2>
    <div class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-6">
      {
        popularCities.map((c) => (
          <a href={paths.city(c.slug)} class="group rounded-xl border border-border bg-surface p-4 hover:border-ink">
            <p class="font-display text-lg font-bold text-ink">{c.name}</p>
            <p class="mt-0.5 text-xs text-ink-faint">{frequencies.filter((f) => f.cityId === c.id).length} frekans</p>
          </a>
        ))
      }
    </div>
    <details class="group mt-4 rounded-xl border border-border bg-surface">
      <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden">
        Tüm iller ({cities.length})
        <span class="text-ink-faint group-open:rotate-180">▾</span>
      </summary>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-1 border-t border-border px-4 py-4 text-sm sm:grid-cols-4 lg:grid-cols-6">
        {cities.map((c) => <li><a href={paths.city(c.slug)} class="text-ink-muted hover:text-ink hover:underline">{c.name}</a></li>)}
      </ul>
    </details>
  </section>

  <section class="mx-auto max-w-(--container-content) px-4 pt-12 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl text-ink sm:text-3xl">Rehberler</h2>
      <a href={paths.guideList()} class="shrink-0 text-sm font-semibold text-ink underline decoration-primary-500 underline-offset-4">Tüm rehberler</a>
    </div>
    <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {guides.map((g) => <GuideCard slug={g.id} title={g.data.title} description={g.data.description} updatedDate={g.data.updatedDate} />)}
    </div>
  </section>

  <section class="mx-auto max-w-(--container-narrow) px-4 pt-6 sm:px-6">
    <FAQSection faqs={faqs} />
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-city-picker]');
  const select = form?.querySelector<HTMLSelectElement>('select');
  const go = (event?: Event) => {
    event?.preventDefault();
    if (select?.value) window.location.href = `/radyo-frekanslari/${select.value}/`;
  };
  form?.addEventListener('submit', go);
  select?.addEventListener('change', () => go());
</script>
